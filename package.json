{
  "private": true,
  "name": "qiln-website",
  "description": "Qiln makes an AI workflow system durable, branchable, and reviewable.",
  "type": "module",
  "version": "0.5.13",
  "license": "UNLICENSED",
  "author": "IonSignal, Inc.",
  "homepage": "https://qiln.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ionsignal/qiln-website.git"
  },
  "bugs": {
    "url": "https://github.com/ionsignal/qiln-website/issues"
  },
  "scripts": {
    "dev": "npm run toml:watch & astro dev",
    "predev": "npm run toml:build",
    "toml:build": "node scripts/toml-watcher.mjs",
    "toml:watch": "node scripts/toml-watcher.mjs --watch",
    "build": "npm run toml:build && astro build",
    "preview": "npm run build && astro preview",
    "astro-check": "npm run toml:build && astro check",
    "typecheck": "npm run astro-check",
    "generate-favicons": "node ./scripts/generate-favicons.mjs",
    "format": "prettier -w ./src",
    "format:check": "prettier --check ./src",
    "preversion": "npm run typecheck",
    "release": "npm run build && tar -czvf qiln-website-v$npm_package_version.tar.gz -C dist .",
    "postversion": "npm run release && git push --follow-tags"
  },
  "engines": {
    "node": ">=22.23.1",
    "npm": ">=10.9.1"
  },
  "allowScripts": {
    "fsevents": false,
    "esbuild": false,
    "core-js": false
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@floating-ui/dom": "1.8.0",
    "@lucide/astro": "1.31.0",
    "@preline/accordion": "4.2.0",
    "@preline/collapse": "4.2.0",
    "@preline/dropdown": "4.2.0",
    "@preline/overlay": "4.2.0",
    "@preline/scrollspy": "4.2.0",
    "@preline/tabs": "4.2.0",
    "astro": "7.2.2",
    "gpu-curtains": "0.16.3",
    "marked": "18.0.9",
    "mdast-util-to-string": "4.0.0",
    "motion": "13.1.0",
    "plyr": "3.8.4",
    "reading-time": "1.5.0",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/sanitize-html": "2.16.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prettier-plugin-toml": "2.0.6",
    "rehype-external-links": "3.0.0",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "toml": "5.0.0",
    "typescript": "6.0.3",
    "unist-util-visit": "5.1.0"
  }
}
