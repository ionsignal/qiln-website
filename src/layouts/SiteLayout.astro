---
import "@/styles/globals.css";

import Header from "@/components/chrome/header/Header.astro";
import Footer from "@/components/chrome/footer/Footer.astro";
import Head from "@/components/global/Head.astro";
import BreakpointIndicator from "@/components/dev/BreakpointIndicator.astro";
import GlobalScripts from "@/components/global/GlobalScripts.astro";
import PageLoader from "@/components/global/PageLoader.astro";
import config from ".astro/config.generated.json";
import type { LayoutProps } from "@/types/seo";

type Props = LayoutProps;

const { class: className } = Astro.props;
---

<!doctype html>
<html lang={config.settings.multilingual.defaultLanguage || "en"}>
  <Head {...Astro.props} />
  <body>
    {!Astro.props.homepage && <PageLoader />}
    <Header {...Astro.props} />
    <main class:list={[className]}>
      <slot />
    </main>
    <Footer />
    <GlobalScripts />
    <BreakpointIndicator />
  </body>
</html>
