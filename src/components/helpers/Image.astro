---
import { Image as AstroImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

type ImageAttributes = Omit<
  HTMLAttributes<"img">,
  "src" | "alt" | "width" | "height"
> & {
  width?: number | `${number}`;
  height?: number | `${number}`;
};

type Props = ImageAttributes & {
  src: string | ImageMetadata | null | undefined;
  alt?: string;
};

const { src, alt = "", ...attributes } = Astro.props;
---

{
  src &&
    (typeof src === "string" ? (
      <AstroImage src={src} alt={alt} inferSize={true} {...attributes} />
    ) : (
      <AstroImage src={src} alt={alt} {...attributes} />
    ))
}
