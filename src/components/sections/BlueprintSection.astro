---
import { Code } from "astro:components";
import Subtitle from "@/components/ui/Subtitle.astro";
import LucideIcon from "@/components/helpers/LucideIcon.astro";
import { markdownify } from "@/utils/text";
import { fetchEntry } from "@/utils/content";
import { overrideObjects } from "@/utils/core";
import type { CollectionEntry } from "astro:content";

type SectionData = CollectionEntry<"sections">["data"];

interface Props {
  content?: SectionData;
  class?: string;
}

const defaultContent = (await fetchEntry("sections", "blueprint"))?.data;
const actualContent = overrideObjects<SectionData>(
  defaultContent ?? {},
  Astro.props.content,
);

const {
  enable = true,
  title,
  subtitle,
  yaml,
  callouts: spotlights = [],
  infoBox,
} = actualContent;
const { class: className } = Astro.props;
---

{
  enable && yaml && (
    <section
      id="blueprint-section"
      class:list={[
        "blueprint-section relative w-full overflow-clip",
        "scroll-mt-24 lg:scroll-mt-32",
        className,
      ]}>
      <div class="container py-16 lg:py-24">
        <div class="motion-header mx-auto mb-16 max-w-2xl text-center opacity-0 will-change-transform">
          {subtitle && <Subtitle content={subtitle} />}
          {title && (
            <h2
              class="has-subtitle-text text-white capitalize"
              set:html={markdownify(title)}
            />
          )}
        </div>
        <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-12">
          <div class="motion-left opacity-0 will-change-transform lg:col-span-7">
            <div class="bg-accent overflow-hidden rounded-xl border shadow-2xl">
              <div class="flex items-center border-b bg-white/5 px-4 py-3">
                <div class="flex space-x-2">
                  <div class="h-3 w-3 rounded-full bg-red-500/80" />
                  <div class="h-3 w-3 rounded-full bg-yellow-500/80" />
                  <div class="h-3 w-3 rounded-full bg-green-500/80" />
                </div>
                <div class="ml-4 font-mono text-xs text-white/50">
                  comfyui-workspace.yaml
                </div>
              </div>
              <div class="code-wrapper overflow-x-auto p-4 font-mono text-sm">
                <Code
                  code={yaml}
                  lang="yaml"
                  theme="github-dark"
                  wrap={false}
                />
              </div>
            </div>
          </div>
          <div class="motion-right opacity-0 will-change-transform lg:col-span-5">
            <div class="sticky top-32 flex flex-col gap-6">
              <div class="flex flex-col gap-4">
                {spotlights.map((spotlight, index) => (
                  <div
                    class="spotlight-card group bg-primary/5 cursor-pointer rounded-xl border p-5 text-left transition-colors duration-300"
                    data-target-lines={JSON.stringify(spotlight.lines)}
                    role="button"
                    tabindex="0"
                    aria-current={index === 0 ? "true" : "false"}>
                    <div class="flex items-start gap-4">
                      <div class="mt-1 shrink-0">
                        <LucideIcon
                          icon={spotlight.icon || "Terminal"}
                          class="text-primary h-6 w-6 transition-transform duration-300 group-hover:scale-110"
                        />
                      </div>
                      <div>
                        <h3
                          class="h6 mb-1 text-white"
                          set:html={markdownify(spotlight.title)}
                        />
                        <p
                          class="text-text-default text-sm leading-relaxed"
                          set:html={markdownify(spotlight.description)}
                        />
                      </div>
                    </div>
                  </div>
                ))}
              </div>
              {infoBox && (
                <div class="border-primary/25 bg-primary/2 rounded-r-lg border-l-2 px-4 py-3">
                  <p
                    class="text-text-default/50 text-sm leading-relaxed"
                    set:html={markdownify(infoBox.description)}
                  />
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .code-wrapper :global(.astro-code) {
    background-color: transparent !important;
    margin: 0;
  }

  .code-wrapper :global(.line) {
    display: inline-block;
    width: 100%;
    padding: 0 0.5rem;
    border-left: 2px solid transparent;
    transition:
      opacity 0.3s ease,
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .code-wrapper.is-interacting :global(.line:not(.highlighted)) {
    opacity: 0.3;
  }

  .code-wrapper.is-interacting :global(.line.highlighted) {
    background-color: color-mix(
      in srgb,
      var(--color-primary) 15%,
      transparent
    ) !important;
    border-left-color: var(--color-primary) !important;
    opacity: 1;
    filter: none;
  }
</style>

<script>
  import { animate, inView } from "motion";

  const sectionCleanups = new Map<HTMLElement, () => void>();

  function getTargetLines(value: string | null): number[] {
    try {
      const parsed: unknown = JSON.parse(value || "[]");

      if (!Array.isArray(parsed)) {
        return [];
      }

      return parsed.filter(
        (line): line is number =>
          typeof line === "number" &&
          Number.isInteger(line) &&
          Number.isFinite(line) &&
          line > 0,
      );
    } catch (error) {
      if (import.meta.env.DEV) {
        console.warn(
          "[BlueprintSection] Invalid data-target-lines attribute",
          error,
        );
      }
      return [];
    }
  }

  function initializeBlueprintSection(section: HTMLElement) {
    if (sectionCleanups.has(section)) return;

    section.setAttribute("data-initialized", "");

    const listenerController = new AbortController();
    const cards = Array.from(
      section.querySelectorAll<HTMLElement>(".spotlight-card"),
    );
    const codeWrapper = section.querySelector<HTMLElement>(".code-wrapper");
    const lines = Array.from(
      codeWrapper?.querySelectorAll<HTMLElement>(".line") || [],
    );
    const header = section.querySelector<HTMLElement>(".motion-header");
    const leftColumn = section.querySelector<HTMLElement>(".motion-left");
    const rightColumn = section.querySelector<HTMLElement>(".motion-right");
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let autopilotTimer: ReturnType<typeof setInterval> | null = null;
    let activeIndex = 0;
    let manuallySelected = false;
    let stopVisibilityTracking: (() => void) | null = null;

    const activateCard = (index: number) => {
      cards.forEach((card) => {
        card.classList.remove("border-primary/50", "bg-primary/20");
        card.setAttribute("aria-current", "false");
      });

      lines.forEach((line) => {
        line.classList.remove("highlighted");
      });

      const targetCard = cards[index];
      if (!targetCard) return;

      activeIndex = index;
      targetCard.classList.add("border-primary/50", "bg-primary/20");
      targetCard.setAttribute("aria-current", "true");

      if (!codeWrapper || lines.length === 0) return;

      codeWrapper.classList.add("is-interacting");

      getTargetLines(targetCard.getAttribute("data-target-lines")).forEach(
        (lineNumber) => {
          lines[lineNumber - 1]?.classList.add("highlighted");
        },
      );
    };

    const clearAutopilot = () => {
      if (autopilotTimer === null) return;

      clearInterval(autopilotTimer);
      autopilotTimer = null;
    };

    const startAutopilot = () => {
      if (manuallySelected || cards.length === 0 || reducedMotion) return;

      clearAutopilot();
      activateCard(activeIndex);

      autopilotTimer = setInterval(() => {
        activeIndex = (activeIndex + 1) % cards.length;
        activateCard(activeIndex);
      }, 4000);
    };

    const stopAutopilot = () => {
      manuallySelected = true;
      clearAutopilot();
    };

    cards.forEach((card, index) => {
      const selectCard = () => {
        stopAutopilot();
        activateCard(index);
      };

      card.addEventListener("mouseenter", selectCard, {
        signal: listenerController.signal,
      });

      card.addEventListener("click", selectCard, {
        signal: listenerController.signal,
      });

      card.addEventListener(
        "keydown",
        (event) => {
          if (event.key !== "Enter" && event.key !== " ") return;

          event.preventDefault();
          selectCard();
        },
        { signal: listenerController.signal },
      );
    });

    if (reducedMotion) {
      [header, leftColumn, rightColumn].forEach((element) => {
        if (!element) return;

        element.style.opacity = "1";
        element.style.transform = "none";
      });

      if (cards.length > 0) {
        activateCard(0);
      }
    } else {
      stopVisibilityTracking = inView(
        section,
        () => {
          if (header) {
            animate(
              header,
              { opacity: [0, 1], y: [30, 0] },
              { duration: 0.6, ease: "easeOut" },
            );
          }

          if (leftColumn) {
            animate(
              leftColumn,
              { opacity: [0, 1], x: [-30, 0] },
              { duration: 0.6, delay: 0.2, ease: "easeOut" },
            );
          }

          if (rightColumn) {
            animate(
              rightColumn,
              { opacity: [0, 1], x: [30, 0] },
              { duration: 0.6, delay: 0.4, ease: "easeOut" },
            );
          }

          startAutopilot();

          return () => {
            clearAutopilot();
          };
        },
        { amount: 0.2 },
      );
    }

    sectionCleanups.set(section, () => {
      clearAutopilot();
      stopVisibilityTracking?.();
      listenerController.abort();
      section.removeAttribute("data-initialized");
    });
  }

  function initializeBlueprintSections() {
    document
      .querySelectorAll<HTMLElement>(".blueprint-section")
      .forEach(initializeBlueprintSection);
  }

  function teardownBlueprintSections() {
    sectionCleanups.forEach((cleanup) => cleanup());
    sectionCleanups.clear();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeBlueprintSections, {
      once: true,
    });
  } else {
    initializeBlueprintSections();
  }

  document.addEventListener("astro:page-load", initializeBlueprintSections);
  document.addEventListener("astro:before-swap", teardownBlueprintSections);
  window.addEventListener("pagehide", teardownBlueprintSections);
  window.addEventListener("pageshow", initializeBlueprintSections);
</script>
