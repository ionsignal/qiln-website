---
interface Props {
  class?: string;
  content: string;
  duration?: number;
  delay?: number;
  stagger?: number;
}

const {
  content,
  class: className,
  duration = 0.6,
  delay = 0,
  stagger = 0.1,
  ...attributes
} = Astro.props;

let processedContent = "";

if (content) {
  const lexer = /(<[^>]+>)|(\s+)|([^<\s]+)/g;
  const matches = content.matchAll(lexer);

  for (const match of matches) {
    if (match[1]) {
      processedContent += match[1];
    } else if (match[2]) {
      processedContent += match[2];
    } else if (match[3]) {
      processedContent += `<span class="word">${match[3]}</span>`;
    }
  }
}
---

<div
  class:list={["animated-text", className]}
  set:html={processedContent}
  data-duration={duration}
  data-delay={delay}
  data-stagger={stagger}
  {...attributes}
/>

<script>
  import { animate, stagger, inView } from "motion";

  const observerCleanups = new Map<HTMLElement, () => void>();

  function getNumericData(
    element: HTMLElement,
    name: string,
    fallback: number,
  ): number {
    const value = Number.parseFloat(element.dataset[name] || "");
    return Number.isFinite(value) ? value : fallback;
  }

  function initializeAnimatedText() {
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    document
      .querySelectorAll<HTMLElement>(".animated-text")
      .forEach((animatedText) => {
        if (animatedText.hasAttribute("data-motion-initialized")) return;
        animatedText.setAttribute("data-motion-initialized", "");
        if (reducedMotion) {
          animatedText.removeAttribute("data-motion-ready");
          return;
        }
        const duration = Math.max(
          getNumericData(animatedText, "duration", 0.6),
          0,
        );
        const delay = Math.max(getNumericData(animatedText, "delay", 0), 0);
        const staggerDelay = Math.max(
          getNumericData(animatedText, "stagger", 0.1),
          0,
        );
        animatedText.setAttribute("data-motion-ready", "");
        const stopObserving = inView(animatedText, (element) => {
          const words = Array.from(
            element.querySelectorAll<HTMLElement>(".word"),
          );
          if (words.length === 0) return;
          animate(
            words,
            {
              opacity: [0, 1],
              y: [10, 0],
              filter: ["blur(10px)", "blur(0px)"],
            },
            {
              duration,
              delay: stagger(staggerDelay, { startDelay: delay }),
              ease: "easeOut",
            },
          );
        });
        observerCleanups.set(animatedText, stopObserving);
      });
  }

  function teardownAnimatedText() {
    observerCleanups.forEach((cleanup) => cleanup());
    observerCleanups.clear();
    document
      .querySelectorAll<HTMLElement>(".animated-text")
      .forEach((animatedText) => {
        animatedText.removeAttribute("data-motion-initialized");
        animatedText.removeAttribute("data-motion-ready");
      });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeAnimatedText, {
      once: true,
    });
  } else {
    initializeAnimatedText();
  }

  window.addEventListener("pagehide", teardownAnimatedText);
  window.addEventListener("pageshow", initializeAnimatedText);
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    :global(.animated-text[data-motion-ready] .word) {
      display: inline-block;
      opacity: 0;
      filter: blur(10px);
      transform: translateY(10px);
      will-change: transform, filter, opacity;
    }
  }
</style>
