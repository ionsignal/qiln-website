---
interface Props {
  class?: string;
  content: string;
  duration?: number;
  delay?: number;
  stagger?: number;
}

const {
  content,
  class: className,
  duration = 0.6,
  delay = 0,
  stagger = 0.1,
  ...attributes
} = Astro.props;

let processedContent = "";

if (content) {
  const lexer = /(<[^>]+>)|(\s+)|([^<\s]+)/g;
  const matches = content.matchAll(lexer);

  for (const match of matches) {
    if (match[1]) {
      processedContent += match[1];
    } else if (match[2]) {
      processedContent += match[2];
    } else if (match[3]) {
      processedContent += `<span class="word">${match[3]}</span>`;
    }
  }
}
---

<div
  class:list={["animated-text", className]}
  set:html={processedContent}
  data-duration={duration}
  data-delay={delay}
  data-stagger={stagger}
  {...attributes}
/>

<script>
  import { animate, stagger, inView } from "motion";

  const animatedTextCleanups = new Map<HTMLElement, () => void>();

  function getNumericData(
    element: HTMLElement,
    name: string,
    fallback: number,
  ): number {
    const value = Number.parseFloat(element.dataset[name] || "");
    return Number.isFinite(value) ? value : fallback;
  }

  function initializeAnimatedText() {
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    document
      .querySelectorAll<HTMLElement>(".animated-text")
      .forEach((animatedText) => {
        if (animatedTextCleanups.has(animatedText)) return;
        if (reducedMotion) return;

        const words = Array.from(
          animatedText.querySelectorAll<HTMLElement>(".word"),
        );
        if (words.length === 0) return;

        const duration = Math.max(
          getNumericData(animatedText, "duration", 0.6),
          0,
        );
        const delay = Math.max(getNumericData(animatedText, "delay", 0), 0);
        const staggerDelay = Math.max(
          getNumericData(animatedText, "stagger", 0.1),
          0,
        );
        const originalWordStyles = words.map((word) => ({
          word,
          opacity: word.style.opacity,
          transform: word.style.transform,
          filter: word.style.filter,
        }));
        let animation: ReturnType<typeof animate> | null = null;
        let stopObserving: (() => void) | null = null;

        const restorePresentation = () => {
          const activeAnimation = animation;
          animation = null;
          try {
            activeAnimation?.stop();
          } finally {
            originalWordStyles.forEach((originalStyles) => {
              originalStyles.word.style.opacity = originalStyles.opacity;
              originalStyles.word.style.transform = originalStyles.transform;
              originalStyles.word.style.filter = originalStyles.filter;
            });
          }
        };

        try {
          stopObserving = inView(animatedText, () => {
            restorePresentation();
            try {
              const wordAnimation = animate(
                words,
                {
                  opacity: [0, 1],
                  y: [10, 0],
                  filter: ["blur(10px)", "blur(0px)"],
                },
                {
                  duration,
                  delay: stagger(staggerDelay, { startDelay: delay }),
                  ease: "easeOut",
                },
              );
              animation = wordAnimation;
              const restoreCompletedAnimation = () => {
                if (animation === wordAnimation) {
                  restorePresentation();
                }
              };
              void Promise.resolve(wordAnimation).then(
                restoreCompletedAnimation,
                restoreCompletedAnimation,
              );
            } catch (error: unknown) {
              restorePresentation();
              console.error(
                "[AnimatedText] Failed to start word animation.",
                error,
              );
            }
          });
        } catch (error: unknown) {
          restorePresentation();
          console.error(
            "[AnimatedText] Failed to observe word animation.",
            error,
          );
        }

        animatedTextCleanups.set(animatedText, () => {
          stopObserving?.();
          restorePresentation();
        });
      });
  }

  function teardownAnimatedText() {
    animatedTextCleanups.forEach((cleanup) => cleanup());
    animatedTextCleanups.clear();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeAnimatedText, {
      once: true,
    });
  } else {
    initializeAnimatedText();
  }

  window.addEventListener("pagehide", teardownAnimatedText);
  window.addEventListener("pageshow", initializeAnimatedText);
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    :global(.animated-text .word) {
      display: inline-block;
    }
  }
</style>
