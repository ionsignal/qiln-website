---
import ProductDiagram from "@/components/deck/slides/diagrams/ProductDiagram.astro";
import type { CollectionEntry } from "astro:content";

type HeroSolutionContent = NonNullable<
  CollectionEntry<"sections">["data"]["heroSolution"]
>;

interface Props {
  content?: HeroSolutionContent;
}

const { content } = Astro.props;
const headingId = "hero-solution-heading";
const descriptionId = "hero-solution-description";
---

{
  content && (
    <section
      class="slide-solution px-4 py-8 md:px-8 md:py-10 lg:px-12 lg:py-8"
      aria-labelledby={headingId}>
      <header class="mx-auto max-w-4xl text-center">
        <p class="text-primary text-xs font-medium tracking-[0.18em] uppercase">
          {content.eyebrow}
        </p>
        <h2 id={headingId} class="mt-3 text-2xl/tight md:text-4xl/tight">
          {content.title}
        </h2>
        <p
          id={descriptionId}
          class="text-text-default mx-auto mt-4 max-w-3xl text-sm leading-relaxed md:text-base">
          {content.description}
        </p>
      </header>
      <figure
        class="solution-visual"
        role="img"
        aria-labelledby={headingId}
        aria-describedby={descriptionId}>
        <ProductDiagram desktopBreakpoint="md" />
      </figure>
    </section>
  )
}

<style>
  .slide-solution {
    display: grid;
    min-height: 42rem;
    grid-template-rows: auto minmax(0, 1fr);
    background:
      radial-gradient(
        circle at 48% 56%,
        color-mix(in srgb, var(--color-primary) 12%, transparent),
        transparent 46%
      ),
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--color-theme-dark) 54%, transparent),
        transparent
      );
  }

  .solution-visual {
    display: flex;
    width: 100%;
    min-width: 0;
    align-items: center;
    margin: 1.5rem 0 0;
  }

  @media (min-width: 1024px) {
    .solution-visual {
      margin-top: 1rem;
    }
  }
</style>
