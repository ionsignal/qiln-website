---
import SolutionDiagram from "@/components/deck/slides/diagrams/SolutionDiagram.astro";
import type { CollectionEntry } from "astro:content";

type HeroProblemContent = NonNullable<
  CollectionEntry<"sections">["data"]["heroProblem"]
>;

interface Props {
  content?: HeroProblemContent;
}

const { content } = Astro.props;
const headingId = "hero-problem-heading";
const descriptionId = "hero-problem-description";
---

{
  content && (
    <section
      class="slide-problem px-4 py-8 md:px-8 md:py-10 lg:px-12 lg:py-8"
      aria-labelledby={headingId}>
      <header class="mx-auto max-w-4xl text-center">
        <p class="text-primary text-xs font-medium tracking-[0.18em] uppercase">
          {content.eyebrow}
        </p>
        <h2 id={headingId} class="mt-3 text-2xl/tight md:text-4xl/tight">
          {content.title}
        </h2>
        <p
          id={descriptionId}
          class="text-text-default mx-auto mt-4 max-w-3xl text-sm leading-relaxed md:text-base">
          {content.description}
        </p>
      </header>
      <div class="problem-visual" aria-describedby={descriptionId}>
        <SolutionDiagram />
      </div>
    </section>
  )
}

<style>
  .slide-problem {
    display: grid;
    min-height: 42rem;
    grid-template-rows: auto minmax(0, 1fr);
    background:
      radial-gradient(
        circle at 72% 52%,
        color-mix(in srgb, var(--color-primary) 9%, transparent),
        transparent 44%
      ),
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--color-theme-dark) 54%, transparent),
        transparent
      );
  }

  .problem-visual {
    display: flex;
    width: 100%;
    min-width: 0;
    align-items: center;
    margin-top: 1.5rem;
  }

  @media (min-width: 1024px) {
    .problem-visual {
      margin-top: 1rem;
    }
  }
</style>
