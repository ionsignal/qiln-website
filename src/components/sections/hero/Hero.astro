---
import LucideIcon from "@/components/helpers/LucideIcon.astro";
import ActionButton from "@/components/ui/ActionButton.astro";
import Badge from "@/components/ui/Badge.astro";
import AnimatedText from "@/components/sections/hero/AnimatedText.astro";
import Diagram from "@/components/docs/diagrams/Diagram.astro";
import Background from "@/components/visualization/Background.astro";
import { overrideObjects, useTranslations } from "@/utils/core";
import { markdownify } from "@/utils/text";
import { fetchEntry } from "@/utils/content";
import type { CollectionEntry } from "astro:content";

type SectionData = CollectionEntry<"sections">["data"];

type Props = {
  content?: SectionData;
};

const t = useTranslations();
const tryNowLabel = t("navigation.buttonLabel");
const defaultContent = (await fetchEntry("sections", "hero"))?.data;
const actualContent = overrideObjects<SectionData>(
  defaultContent ?? {},
  Astro.props.content,
);

const { title, subtitle, badge, description, buttons } = actualContent;
---

<section id="home" class="scroll-mt-24 lg:scroll-mt-32">
  <div class="banner-gradient stretched-link relative pt-12 pb-12 md:pt-12 md:pb-16 lg:pt-12 lg:pb-20 xl:pt-16 xl:pb-24">
    <Background id="hero-bg-canvas" />
    <div class="container">
      <div class="relative z-10 space-y-10">
        <div class="flex flex-col items-start gap-y-8 text-left md:gap-y-10">
          {badge && (
            <Badge
              content={badge}
              href="/blog/agents-get-forks-not-production/"
              class="word"
            />
          )}
          <div class="relative inline-block w-full">
            {(title || subtitle) && (
              <h1 class="has-subtitle-text font-secondary flex flex-col gap-y-2 text-left text-3xl/tight text-white max-[425px]:text-2xl/tight md:gap-y-4 md:text-5xl/tight lg:text-6xl/tight">
                {title && (
                  <span
                    class="text-primary text-4xl font-bold md:text-5xl lg:text-6xl"
                    set:html={markdownify(title)}
                  />
                )}
                {subtitle && (
                  <span
                    class="text-xl font-bold text-white/80 md:text-2xl lg:text-5xl"
                    set:html={markdownify(subtitle)}
                  />
                )}
              </h1>
            )}
          </div>
          {description && (
            <AnimatedText
              class="hero-description [&_strong]:text-secondary [&_b]:text-secondary w-full max-w-2xl text-left text-lg/normal text-white/90 [&_strong]:font-medium md:[&_strong]:whitespace-nowrap"
              duration={0.35}
              delay={0.05}
              stagger={0.01}
              content={markdownify(description)}
            />
          )}
        </div>
        <div
          data-aos="fade-in"
          data-aos-delay="400"
          data-aos-duration="900"
          class="flex flex-col items-start justify-start gap-4 sm:flex-row">
          <button
            type="button"
            disabled
            class="btn btn-md btn-solid-primary flex h-14 w-full max-w-full items-center justify-center gap-3 font-bold sm:max-w-72">
            {tryNowLabel}
            <LucideIcon
              icon="Play"
              class="h-5 w-5 shrink-0"
              aria-hidden="true"
            />
          </button>
          {buttons?.map((button) => (
            <ActionButton
              content={button}
              class:list={[
                "btn-md btn-has-icon group relative z-0 flex w-full items-center justify-center gap-4 sm:w-auto [&>.label]:z-20",
                button.variant === "secondary"
                  ? "text-light border border-white/15 bg-white/5 shadow-none backdrop-blur-md transition-all duration-300 hover:border-white/30 hover:bg-white/10 hover:text-white"
                  : "btn-solid-primary",
              ]}>
              <span class="rounded-ful flex h-6 w-12 items-center justify-center">
                <LucideIcon
                  icon={button.icon || "BookOpen"}
                  class="h-5 w-5"
                  aria-hidden="true"
                />
              </span>
            </ActionButton>
          ))}
        </div>
      </div>
    </div>
    <div class="relative mt-12 flex w-full justify-center px-4 xl:mt-16">
      <div class="hero-product-frame w-full max-w-337.5">
        <Diagram scale={0.9} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-product-frame {
    position: relative;
    z-index: 10;
    overflow: hidden;
    border: solid color-mix(in srgb, var(--color-primary) 12%, transparent) 2px;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--color-theme-dark) 58%, transparent);
    box-shadow:
      0 24px 60px rgb(0 0 0 / 0.24),
      inset 0 1px 0 rgb(255 255 255 / 0.035);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
  }

  .hero-product-frame::after {
    position: absolute;
    z-index: 20;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--color-primary) 5%, transparent)
    );
    content: "";
  }

  @media (min-width: 768px) {
    .hero-product-frame {
      border-radius: 1.5rem;
    }
  }
</style>
