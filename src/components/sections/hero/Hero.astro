---
import config from ".astro/config.generated.json";
import SvgIcon from "@/components/helpers/SvgIcon.astro";
import ActionButton from "@/components/ui/ActionButton.astro";
import Badge from "@/components/ui/Badge.astro";
import AnimatedText from "@/components/sections/hero/AnimatedText.astro";
import Subscription from "@/components/sections/hero/Subscription.astro";
import Slider from "@/components/sections/hero/Slider.astro";
import Background from "@/components/sections/hero/Background.astro";
import { overrideObjects } from "@/utils/core";
import { markdownify } from "@/utils/text";
import { fetchEntry } from "@/utils/content";
import type { CollectionEntry } from "astro:content";

type SectionData = CollectionEntry<"sections">["data"];

type Props = {
  content?: SectionData;
};

type TickerTitle =
  | {
      isTicker: true;
      prefix: string;
      options: string[];
      suffix: string;
      longestOption: string;
      fallbackTitle: string;
    }
  | {
      isTicker: false;
    };

const defaultContent = (await fetchEntry("sections", "hero"))?.data;
const actualContent = overrideObjects<SectionData>(
  defaultContent ?? {},
  Astro.props.content,
);

const {
  title,
  subtitle,
  badge,
  description,
  buttons,
  subscription,
  heroProblem,
  heroSolution,
  heroDiagram,
} = actualContent;

function parseTickerTitle(rawTitle: string | undefined): TickerTitle {
  if (!rawTitle) return { isTicker: false };
  const match = rawTitle.match(/^(.*?)\[(.*?)\](.*)$/);
  if (!match) return { isTicker: false };
  const prefix = match[1].trim();
  const options = match[2]
    .split("|")
    .map((option) => option.trim())
    .filter(Boolean);
  const suffix = match[3].trim();
  if (options.length < 2) return { isTicker: false };
  const longestOption = options.reduce(
    (currentLongest, option) =>
      currentLongest.length > option.length ? currentLongest : option,
    "",
  );
  const fallbackTitle = `${prefix} ${options[0]} ${suffix}`.trim();
  return {
    isTicker: true,
    prefix,
    options,
    suffix,
    longestOption,
    fallbackTitle,
  };
}

const tickerTitle = parseTickerTitle(title);
---

<section id="home" class="scroll-mt-24 lg:scroll-mt-32">
  <div
    class="banner-gradient stretched-link relative pt-12 pb-12 md:pt-12 md:pb-16 lg:pt-12 lg:pb-20 xl:pt-16 xl:pb-24">
    <Background />
    <div class="container">
      <div class="relative z-10 space-y-10">
        <div class="flex flex-col items-start gap-y-8 text-left md:gap-y-10">
          {
            badge && (
              <div
                class="animated-text"
                data-duration="0.6"
                data-delay="0.2"
                data-stagger="0.1">
                <Badge content={badge} href="/blog" class="word" />
              </div>
            )
          }
          <div class="relative inline-block w-full">
            {
              (title || subtitle) && (
                <h1 class="has-subtitle-text font-secondary flex flex-col gap-y-2 text-left text-3xl/tight text-white max-[425px]:text-2xl/tight md:gap-y-4 md:text-5xl/tight lg:text-6xl/tight">
                  {tickerTitle.isTicker ? (
                    <>
                      <span
                        class="sr-only"
                        set:html={markdownify(tickerTitle.fallbackTitle)}
                      />
                      <qiln-ticker aria-hidden="true" class="inline text-left">
                        {tickerTitle.prefix && (
                          <span set:html={markdownify(tickerTitle.prefix)} />
                        )}
                        <span class="text-primary relative isolate z-0 -mx-3 inline-flex items-baseline gap-0 px-0 py-0 align-baseline whitespace-nowrap">
                          <span class="ticker-container relative z-10 inline-grid items-baseline justify-items-start overflow-hidden text-left">
                            <span class="invisible col-start-1 row-start-1">
                              {tickerTitle.longestOption}
                            </span>
                            {tickerTitle.options.map((option, index) => (
                              <span
                                class:list={[
                                  "ticker-item col-start-1 row-start-1 will-change-[transform,filter,opacity]",
                                  index === 0 ? "opacity-100" : "opacity-0",
                                ]}>
                                {option}
                              </span>
                            ))}
                          </span>
                        </span>
                        {tickerTitle.suffix && (
                          <span set:html={markdownify(tickerTitle.suffix)} />
                        )}
                      </qiln-ticker>
                    </>
                  ) : (
                    title && (
                      <span
                        class="text-primary text-4xl font-bold md:text-5xl lg:text-6xl"
                        set:html={markdownify(title)}
                      />
                    )
                  )}
                  {subtitle && (
                    <span
                      class="text-xl font-bold text-white/80 md:text-2xl lg:text-5xl"
                      set:html={markdownify(subtitle)}
                    />
                  )}
                </h1>
              )
            }
          </div>
          {
            description && (
              <AnimatedText
                class="hero-description [&_strong]:text-secondary [&_b]:text-secondary w-full max-w-2xl text-left text-lg/normal text-white/90 [&_strong]:font-medium md:[&_strong]:whitespace-nowrap"
                stagger={0.03}
                delay={0.4}
                content={markdownify(description)}
              />
            )
          }
        </div>
        <div
          data-aos="fade-in"
          data-aos-delay="400"
          data-aos-duration="900"
          class="flex flex-col items-start justify-start gap-4 sm:flex-row">
          {
            subscription?.enable && config.settings.navigationButton.enable && (
              <Subscription />
            )
          }
          {
            buttons?.map((button) => (
              <ActionButton
                content={button}
                class:list={[
                  "btn-md btn-has-icon group relative z-0 flex w-full items-center justify-center gap-4 sm:w-auto [&>.label]:z-20",
                  button.variant === "secondary"
                    ? "text-light border border-white/15 bg-white/5 shadow-none backdrop-blur-md transition-all duration-300 hover:border-white/30 hover:bg-white/10 hover:text-white"
                    : "btn-solid-primary",
                ]}>
                <span class="rounded-ful flex h-6 w-12 items-center justify-center">
                  <SvgIcon
                    icon={button.icon || "star"}
                    class="h-5 w-5 transition-all duration-300 group-hover:rotate-180"
                  />
                </span>
              </ActionButton>
            ))
          }
        </div>
      </div>
    </div>
    <div class="relative container mt-12 px-4 md:px-8 lg:px-0 xl:mt-16 xl:px-4">
      <div class="hero-product-frame">
        <Slider
          problem={heroProblem}
          solution={heroSolution}
          content={heroDiagram}
          scale={0.94}
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from "motion";

  class QilnTicker extends HTMLElement {
    private interval: ReturnType<typeof setInterval> | null = null;
    private observer: IntersectionObserver | null = null;
    private currentIndex = 0;
    private items: HTMLElement[] = [];

    connectedCallback() {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      this.items = Array.from(
        this.querySelectorAll<HTMLElement>(".ticker-item"),
      );
      if (this.items.length < 2) return;
      this.observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.startInterval();
            } else {
              this.stopInterval();
            }
          });
        },
        { threshold: 0 },
      );
      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.stopInterval();
      this.observer?.disconnect();
      this.observer = null;
    }

    private startInterval() {
      if (!this.interval) {
        this.interval = setInterval(() => this.runAnimation(), 3000);
      }
    }

    private stopInterval() {
      if (this.interval) {
        clearInterval(this.interval);
        this.interval = null;
      }
    }

    private runAnimation() {
      const outgoingItem = this.items[this.currentIndex];
      this.currentIndex = (this.currentIndex + 1) % this.items.length;
      const incomingItem = this.items[this.currentIndex];
      if (!outgoingItem || !incomingItem) return;
      animate(
        outgoingItem,
        {
          y: ["0%", "-100%"],
          opacity: [1, 0],
          filter: ["blur(0px)", "blur(4px)"],
        },
        { type: "spring", stiffness: 400, damping: 30 },
      );
      animate(
        incomingItem,
        {
          y: ["100%", "0%"],
          opacity: [0, 1],
          filter: ["blur(4px)", "blur(0px)"],
        },
        { type: "spring", stiffness: 400, damping: 30 },
      );
    }
  }

  if (!customElements.get("qiln-ticker")) {
    customElements.define("qiln-ticker", QilnTicker);
  }
</script>

<style>
  .hero-product-frame {
    position: relative;
    z-index: 10;
    overflow: hidden;
    border: solid color-mix(in srgb, var(--color-primary) 24%, transparent) 2px;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--color-theme-dark) 58%, transparent);
    box-shadow:
      0 24px 60px rgb(0 0 0 / 0.24),
      inset 0 1px 0 rgb(255 255 255 / 0.035);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
  }

  .hero-product-frame::after {
    position: absolute;
    z-index: 20;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--color-primary) 5%, transparent)
    );
    content: "";
  }

  @media (min-width: 768px) {
    .hero-product-frame {
      border-radius: 1.5rem;
    }
  }
</style>
