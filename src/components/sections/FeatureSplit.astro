---
import { fetchEntry } from "@/utils/content";
import { markdownify, plainify } from "@/utils/text";
import Image from "@/components/helpers/Image.astro";
import LucideIcon from "@/components/helpers/LucideIcon.astro";
import Subtitle from "@/components/ui/Subtitle.astro";
import type { CollectionEntry } from "astro:content";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

type SectionData = CollectionEntry<"sections">["data"];

type Props = {
  content?: SectionData;
  diagram?: AstroComponentFactory;
  imagePosition?: "left" | "right";
  class?: string;
  id?: string;
  hasBackground?: boolean;
};

const defaultContent = (await fetchEntry("sections", "known-good-snapshots"))
  ?.data;
const actualContent: SectionData = Astro.props.content ?? defaultContent ?? {};
const {
  enable = true,
  title,
  subtitle,
  description,
  columns = 1,
  features,
  image,
  imageAlt,
} = actualContent;
const {
  diagram: Diagram,
  imagePosition = "right",
  class: className,
  id,
  hasBackground = false,
} = Astro.props;
const resolvedImageAlt = imageAlt?.trim() || plainify(title);
const diagramLabel =
  plainify(title) || plainify(subtitle) || "Section illustration";
const diagramDescription =
  resolvedImageAlt || plainify(description) || diagramLabel;
const hasVisual = Boolean(Diagram || image);
---

{enable && (
  <section
    id={id}
    class:list={[
      "feature-split relative w-full overflow-hidden",
      "scroll-mt-24 lg:scroll-mt-32",
      { "bg-accent/50": hasBackground },
      className,
    ]}
    data-direction={imagePosition}>
    <div class="container py-16 lg:py-24">
      <div
        class:list={[
          "grid grid-cols-1 gap-12 lg:items-center",
          imagePosition === "left"
            ? "lg:grid-cols-[minmax(0,14fr)_minmax(0,11fr)]"
            : "lg:grid-cols-[minmax(0,11fr)_minmax(0,14fr)]",
        ]}>
        <div
          class:list={[
            "motion-text",
            imagePosition === "left" ? "lg:order-2" : "lg:order-1",
          ]}>
          <div class="mx-auto flex max-w-xl flex-col gap-6 lg:gap-3 xl:gap-7">
            {subtitle && <Subtitle content={subtitle} />}
            {title && (
              <h2
                class="has-subtitle-text capitalize lg:text-h4 xl:text-h2"
                set:html={markdownify(title)}
              />
            )}
            {description && (
              <p
                class="text-text-default mx-auto max-w-4xl text-base leading-relaxed md:text-lg"
                set:html={markdownify(description)}
              />
            )}
            {features && features.length > 0 && (
              <ul
                class:list={[
                  "mt-2 gap-3",
                  columns === 2 ? "grid grid-cols-2" : "flex flex-col",
                ]}>
                {features.map((feature) => (
                  <li class="grid min-w-0 grid-cols-[1.25rem_minmax(0,1fr)] items-start gap-3">
                    <LucideIcon
                      icon="CheckCircle2"
                      class="text-primary mt-0.5 h-5 w-5 shrink-0"
                    />
                    <span
                      class="min-w-0 text-sm text-white/70"
                      set:html={markdownify(feature)}
                    />
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
        <div
          class:list={[
            "motion-image relative",
            imagePosition === "left" ? "lg:order-1" : "lg:order-2",
          ]}>
          {hasVisual && (
            <>
              <div
                aria-hidden="true"
                class:list={[
                  "bg-[radial-gradient(50%_50%_at_50%_50%,--theme(--color-primary/20%)_0%,--theme(--color-primary/0%)_100%)] pointer-events-none absolute inset-0 -z-10 scale-110",
                  imagePosition === "right"
                    ? "translate-x-8 translate-y-10 lg:translate-x-16 lg:translate-y-16"
                    : "-translate-x-8 translate-y-10 lg:-translate-x-16 lg:translate-y-16",
                ]}
              />
              <div
                class:list={[
                  "relative",
                  Diagram ? "overflow-visible" : "overflow-hidden",
                ]}>
                {Diagram ? (
                  <Diagram
                    label={diagramLabel}
                    description={diagramDescription}
                  />
                ) : (
                  image && (
                    <Image
                      src={image}
                      alt={resolvedImageAlt}
                      class="h-auto w-full"
                    />
                  )
                )}
              </div>
            </>
          )}
        </div>
      </div>
    </div>
  </section>
)}

<script>
  import { animate } from "motion";

  interface PreparedFeatureEntrance {
    originalOpacity: string;
    originalOpacityPriority: string;
    originalTransform: string;
    originalTransformPriority: string;
    isImage: boolean;
    imagePosition: string | null;
    animation: ReturnType<typeof animate> | null;
    recoveryTimeoutId: number | null;
  }

  const consumedFeatureTargets = new WeakSet<HTMLElement>();
  const preparedFeatureEntrances = new Map<
    HTMLElement,
    PreparedFeatureEntrance
  >();
  const completionRecoveryBufferMs = 2000;

  let featureEntranceObserver: IntersectionObserver | null = null;
  let featureMotionController: AbortController | null = null;

  function restoreFeatureEntrance(
    element: HTMLElement,
    entrance: PreparedFeatureEntrance,
  ): void {
    if (preparedFeatureEntrances.get(element) !== entrance) return;
    preparedFeatureEntrances.delete(element);
    if (entrance.recoveryTimeoutId !== null) {
      window.clearTimeout(entrance.recoveryTimeoutId);
      entrance.recoveryTimeoutId = null;
    }
    const animation = entrance.animation;
    entrance.animation = null;
    try {
      animation?.stop();
    } catch (error: unknown) {
      console.error("[FeatureSplit] Failed to stop entrance animation.", error);
    } finally {
      if (entrance.originalOpacity) {
        element.style.setProperty(
          "opacity",
          entrance.originalOpacity,
          entrance.originalOpacityPriority,
        );
      } else {
        element.style.removeProperty("opacity");
      }
      if (entrance.originalTransform) {
        element.style.setProperty(
          "transform",
          entrance.originalTransform,
          entrance.originalTransformPriority,
        );
      } else {
        element.style.removeProperty("transform");
      }
    }
  }

  function disconnectFeatureEntranceObserver(): void {
    featureEntranceObserver?.disconnect();
    featureEntranceObserver = null;
  }

  function restoreFeatureEntrances(): void {
    preparedFeatureEntrances.forEach((entrance, element) => {
      restoreFeatureEntrance(element, entrance);
    });
  }

  function playFeatureEntrance(
    element: HTMLElement,
    entrance: PreparedFeatureEntrance,
  ): void {
    if (
      preparedFeatureEntrances.get(element) !== entrance ||
      consumedFeatureTargets.has(element)
    ) {
      return;
    }
    consumedFeatureTargets.add(element);
    if (
      !element.isConnected ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      restoreFeatureEntrance(element, entrance);
      return;
    }
    const duration = entrance.isImage ? 0.9 : 0.8;
    try {
      // Recovery owns restoration even if an interrupted animation never settles.
      entrance.recoveryTimeoutId = window.setTimeout(() => {
        restoreFeatureEntrance(element, entrance);
      }, duration * 1000 + completionRecoveryBufferMs);
      const animation = entrance.isImage
        ? animate(
            element,
            {
              opacity: [0, 1],
              scale: [1.04, 1],
              x: [entrance.imagePosition === "left" ? -40 : 40, 0],
            },
            {
              type: "spring",
              bounce: 0.3,
              duration,
            },
          )
        : animate(
            element,
            { opacity: [0, 1], y: [30, 0] },
            { duration, ease: "easeOut" },
          );
      entrance.animation = animation;
      void Promise.resolve(animation).then(
        () => restoreFeatureEntrance(element, entrance),
        (error: unknown) => {
          if (preparedFeatureEntrances.get(element) !== entrance) return;
          restoreFeatureEntrance(element, entrance);
          console.error("[FeatureSplit] Entrance animation failed.", error);
        },
      );
    } catch (error: unknown) {
      restoreFeatureEntrance(element, entrance);
      console.error("[FeatureSplit] Failed to start entrance animation.", error);
    }
  }

  function prepareFeatureTarget(
    element: HTMLElement,
    observer: IntersectionObserver,
    isImage: boolean,
    imagePosition: string | null,
  ): void {
    if (
      consumedFeatureTargets.has(element) ||
      preparedFeatureEntrances.has(element)
    ) {
      return;
    }
    const bounds = element.getBoundingClientRect();
    if (bounds.width <= 0 || bounds.height <= 0) return;
    if (bounds.bottom <= 0) {
      consumedFeatureTargets.add(element);
      return;
    }
    const viewportWidth =
      document.documentElement.clientWidth || window.innerWidth;
    const viewportHeight =
      document.documentElement.clientHeight || window.innerHeight;
    if (bounds.right <= 0 || bounds.left >= viewportWidth) return;
    if (bounds.top < viewportHeight) {
      consumedFeatureTargets.add(element);
      return;
    }
    const entrance: PreparedFeatureEntrance = {
      originalOpacity: element.style.opacity,
      originalOpacityPriority: element.style.getPropertyPriority("opacity"),
      originalTransform: element.style.transform,
      originalTransformPriority: element.style.getPropertyPriority("transform"),
      isImage,
      imagePosition,
      animation: null,
      recoveryTimeoutId: null,
    };
    preparedFeatureEntrances.set(element, entrance);
    element.style.opacity = "0";
    observer.observe(element);
  }

  function prepareFeatureEntrances(): void {
    if (
      featureEntranceObserver ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
      typeof IntersectionObserver === "undefined"
    ) {
      return;
    }
    try {
      const observer = new IntersectionObserver(
        (entries) => {
          if (featureEntranceObserver !== observer) return;
          entries.forEach((entry) => {
            if (
              !entry.isIntersecting ||
              !(entry.target instanceof HTMLElement)
            ) {
              return;
            }
            observer.unobserve(entry.target);
            const entrance = preparedFeatureEntrances.get(entry.target);
            if (entrance) {
              playFeatureEntrance(entry.target, entrance);
            }
          });
        },
        { threshold: 0 },
      );
      featureEntranceObserver = observer;
      document
        .querySelectorAll<HTMLElement>(".feature-split")
        .forEach((section) => {
          const imagePosition = section.getAttribute("data-direction");
          const textElement =
            section.querySelector<HTMLElement>(".motion-text");
          const imageElement =
            section.querySelector<HTMLElement>(".motion-image");
          if (textElement) {
            prepareFeatureTarget(textElement, observer, false, imagePosition);
          }
          if (imageElement) {
            prepareFeatureTarget(imageElement, observer, true, imagePosition);
          }
        });
    } catch (error: unknown) {
      disconnectFeatureEntranceObserver();
      restoreFeatureEntrances();
      console.error("[FeatureSplit] Failed to prepare entrances.", error);
    }
  }

  function initializeFeatureEntrances(): void {
    if (featureMotionController) return;
    const controller = new AbortController();
    featureMotionController = controller;
    try {
      const motionPreference = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      motionPreference.addEventListener(
        "change",
        () => {
          if (motionPreference.matches) {
            disconnectFeatureEntranceObserver();
            restoreFeatureEntrances();
          } else {
            prepareFeatureEntrances();
          }
        },
        { signal: controller.signal },
      );
      prepareFeatureEntrances();
    } catch (error: unknown) {
      teardownFeatureEntrances();
      console.error("[FeatureSplit] Failed to initialize entrances.", error);
    }
  }

  function teardownFeatureEntrances(): void {
    featureMotionController?.abort();
    featureMotionController = null;
    disconnectFeatureEntranceObserver();
    restoreFeatureEntrances();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeFeatureEntrances, {
      once: true,
    });
  } else {
    initializeFeatureEntrances();
  }

  window.addEventListener("pagehide", teardownFeatureEntrances);
  window.addEventListener("pageshow", initializeFeatureEntrances);
</script>
