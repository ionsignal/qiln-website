---
import { markdownify } from "@/utils/text";
import LucideIcon from "@/components/helpers/LucideIcon.astro";
import ButtonLink from "@/components/buttons/ButtonLink.astro";
import type { CollectionEntry } from "astro:content";

type SectionData = CollectionEntry<"sections">["data"];
interface Props {
  content: SectionData;
}

const { content } = Astro.props;
const { pricingPlans = [] } = content;
---

<section class="relative w-full py-16 lg:py-24">
  <div class="container">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-3 lg:gap-8">
      {
        pricingPlans.map((plan) => (
          <div
            class:list={[
              "relative flex h-full flex-col rounded-3xl border p-8 transition-all duration-300",
              plan.highlight
                ? "bg-primary/5 border-primary/50 shadow-[0_0_30px_--theme(--color-primary/15%)]"
                : "border-white/10 bg-white/5 hover:border-white/20 hover:bg-white/10",
            ]}>
            <div class="mb-6">
              <h3 class="text-h5 font-secondary mb-2 font-medium text-white">
                {plan.name}
              </h3>
              <div class="mb-4 flex items-baseline gap-2">
                <span class="text-h2 font-secondary font-bold text-white">
                  {plan.price}
                </span>
                {plan.period && (
                  <span class="text-text-default text-sm font-medium">
                    {plan.period}
                  </span>
                )}
              </div>
              <p class="text-text-default text-sm leading-relaxed">
                {plan.description}
              </p>
            </div>
            <hr class="mb-8 border-white/10" />
            <ul class="mb-8 flex flex-col gap-4">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-3">
                  <LucideIcon
                    icon="CheckCircle2"
                    class="text-primary mt-0.5 h-5 w-5 shrink-0"
                  />
                  <span
                    class="text-sm text-white/80 [&_strong]:font-medium [&_strong]:text-white"
                    set:html={markdownify(feature)}
                  />
                </li>
              ))}
            </ul>
            <div class="mt-auto pt-4">
              {plan.button && plan.button.enable && (
                <ButtonLink
                  content={plan.button}
                  class:list={[
                    "w-full py-3 text-center",
                    plan.highlight
                      ? "btn-solid-primary"
                      : "text-light border border-white/15 bg-white/5 shadow-none backdrop-blur-md transition-all duration-300 hover:border-white/30 hover:bg-white/10 hover:text-white",
                  ]}
                />
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
