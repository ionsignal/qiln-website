---
import config from ".astro/config.generated.json";
import SvgIcon from "@/components/helpers/SvgIcon.astro";
import ButtonLink from "@/components/buttons/ButtonLink.astro";
import AnimatedText from "@/components/widgets/AnimatedText.astro";
import Badge from "@/components/widgets/Badge.astro";
import HeroSubscription from "@/components/widgets/HeroSubscription.astro";
import HeroProductDiagram from "@/components/widgets/HeroProductDiagram.astro";
import Visualization from "@/components/widgets/Visualization.astro";
import { overrideObjects } from "@/utils/core";
import { markdownify } from "@/utils/text";
import { fetchEntry } from "@/utils/content";
import type { CollectionEntry } from "astro:content";

type SectionData = CollectionEntry<"sections">["data"];
type Props = {
  content?: SectionData;
};

let defaultContent = (await fetchEntry("sections", "home-banner"))?.data;
let actualContent = overrideObjects({ ...defaultContent }, Astro.props.content);
let { title, subtitle, badge, customers, description, buttons, subscription } =
  actualContent;

function parseTickerTitle(rawTitle: string | undefined) {
  if (!rawTitle) return { isTicker: false };
  const match = rawTitle.match(/^(.*?)\[(.*?)\](.*)$/);
  if (match) {
    const prefix = match[1].trim();
    const options = match[2]
      .split("|")
      .map((s) => s.trim())
      .filter(Boolean);
    const suffix = match[3].trim();
    if (options.length > 1) {
      const longestOption = options.reduce(
        (a, b) => (a.length > b.length ? a : b),
        "",
      );
      const fallbackTitle = `${prefix} ${options[0]} ${suffix}`.trim();
      return {
        isTicker: true,
        prefix,
        options,
        suffix,
        longestOption,
        fallbackTitle,
      };
    }
  }
  return { isTicker: false };
}

const tickerTitle = parseTickerTitle(title);
---

<section id="home" class="scroll-mt-24 lg:scroll-mt-32">
  <div
    class="banner-gradient stretched-link relative pt-12 md:pt-12 lg:pt-12 xl:pt-16">
    <Visualization />
    <div class="container">
      <div class="relative z-10 max-w-4xl space-y-10">
        <div class="flex flex-col items-start gap-y-8 text-left md:gap-y-10">
          {
            badge && (
              <div
                class="animated-text"
                data-duration="0.6"
                data-delay="0.2"
                data-stagger="0.1">
                <Badge content={badge} href="/blog" class="word" />
              </div>
            )
          }
          <div class="relative inline-block w-full">
            {
              (title || subtitle) && (
                <h1 class="has-subtitle-text font-secondary flex flex-col gap-y-2 text-left text-3xl/tight text-white max-[425px]:text-2xl/tight md:gap-y-4 md:text-5xl/tight lg:text-6xl/tight">
                  {tickerTitle.isTicker ? (
                    <>
                      <span
                        class="sr-only"
                        set:html={markdownify(tickerTitle.fallbackTitle)}
                      />
                      <qiln-ticker aria-hidden="true" class="inline text-left">
                        {tickerTitle.prefix && (
                          <span set:html={markdownify(tickerTitle.prefix)} />
                        )}
                        <span class="text-primary relative isolate z-0 -mx-3 inline-flex items-baseline gap-0 px-0 py-0 align-baseline whitespace-nowrap">
                          <span class="ticker-container relative z-10 inline-grid items-baseline justify-items-start overflow-hidden text-left">
                            <span class="invisible col-start-1 row-start-1">
                              {tickerTitle.longestOption}
                            </span>
                            {tickerTitle.options?.map((opt, i) => (
                              <span
                                class:list={[
                                  "ticker-item col-start-1 row-start-1 will-change-[transform,filter,opacity]",
                                  i === 0 ? "opacity-100" : "opacity-0",
                                ]}>
                                {opt}
                              </span>
                            ))}
                          </span>
                        </span>
                        {tickerTitle.suffix && (
                          <span set:html={markdownify(tickerTitle.suffix)} />
                        )}
                      </qiln-ticker>
                    </>
                  ) : (
                    title && <span set:html={markdownify(title)} />
                  )}
                  {subtitle && (
                    <span
                      class="text-xl/loose font-bold text-white/80 md:text-4xl lg:text-5xl"
                      set:html={markdownify(subtitle)}
                    />
                  )}
                </h1>
              )
            }
          </div>
          {
            description && (
              <AnimatedText
                class="home-banner-description [&_strong]:text-secondary [&_b]:text-secondary w-full max-w-4xl text-left text-lg/normal text-white/90 [&_strong]:font-medium md:[&_strong]:whitespace-nowrap"
                stagger={0.03}
                delay={0.4}
                content={markdownify(description)}
              />
            )
          }
        </div>
        <div
          data-aos="fade-in"
          data-aos-delay="400"
          data-aos-duration="900"
          class="flex flex-col items-start justify-start gap-4 sm:flex-row">
          {
            subscription?.enable && config.settings.navigationButton.enable && (
              <HeroSubscription />
            )
          }
          {
            buttons &&
              buttons.map((button) => (
                <ButtonLink
                  content={button}
                  class:list={[
                    "btn-md btn-has-icon group relative z-0 flex w-full items-center justify-center gap-4 sm:w-auto [&>.label]:z-20",
                    button.variant === "secondary"
                      ? "text-light border border-white/15 bg-white/5 shadow-none backdrop-blur-md transition-all duration-300 hover:border-white/30 hover:bg-white/10 hover:text-white"
                      : "btn-solid-primary",
                  ]}>
                  <span class="rounded-ful flex h-6 w-12 items-center justify-center">
                    <SvgIcon
                      icon={button.icon || "star"}
                      class="h-5 w-5 transition-all duration-300 group-hover:rotate-180"
                    />
                  </span>
                </ButtonLink>
              ))
          }
        </div>
      </div>
    </div>
    <div
      class="relative container mt-12 -mb-4 px-4 md:mb-0 md:px-8 lg:px-0 xl:mt-16 xl:px-4">
      <div class="hero-product-frame">
        <HeroProductDiagram />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-product-frame {
    position: relative;
    z-index: 10;
    overflow: hidden;
    border-radius: 1rem 1rem 0 0;
    background: rgb(12 18 33 / 0.5);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
  }

  .hero-product-frame::after {
    position: absolute;
    z-index: 20;
    right: 0;
    bottom: 0;
    left: 0;
    height: 80%;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, var(--color-body));
    content: "";
  }
</style>

<script>
  import { animate } from "motion";

  class QilnTicker extends HTMLElement {
    private interval: ReturnType<typeof setInterval> | null = null;
    private observer: IntersectionObserver | null = null;
    private currentIndex = 0;
    private items: HTMLElement[] = [];

    connectedCallback() {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      this.items = Array.from(this.querySelectorAll(".ticker-item"));
      if (this.items.length < 2) return;
      this.observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.startInterval();
            } else {
              this.stopInterval();
            }
          });
        },
        { threshold: 0 },
      );
      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.stopInterval();
      if (this.observer) {
        this.observer.disconnect();
        this.observer = null;
      }
    }

    private startInterval() {
      if (!this.interval) {
        this.interval = setInterval(() => this.runAnimation(), 3000);
      }
    }

    private stopInterval() {
      if (this.interval) {
        clearInterval(this.interval);
        this.interval = null;
      }
    }

    private runAnimation() {
      const outgoing = this.items[this.currentIndex];
      this.currentIndex = (this.currentIndex + 1) % this.items.length;
      const incoming = this.items[this.currentIndex];
      animate(
        outgoing,
        {
          y: ["0%", "-100%"],
          opacity: [1, 0],
          filter: ["blur(0px)", "blur(4px)"],
        },
        { type: "spring", stiffness: 400, damping: 30 },
      );
      animate(
        incoming,
        {
          y: ["100%", "0%"],
          opacity: [0, 1],
          filter: ["blur(4px)", "blur(0px)"],
        },
        { type: "spring", stiffness: 400, damping: 30 },
      );
    }
  }

  if (!customElements.get("qiln-ticker")) {
    customElements.define("qiln-ticker", QilnTicker);
  }
</script>
