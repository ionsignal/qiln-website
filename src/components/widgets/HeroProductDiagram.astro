---
import LucideIcon from "@/components/helpers/LucideIcon.astro";
import type { CollectionEntry } from "astro:content";

type HeroDiagramContent = NonNullable<
  CollectionEntry<"sections">["data"]["heroDiagram"]
>;

interface Props {
  class?: string;
  content?: HeroDiagramContent;
  scale?: number;
}

const { class: className, content, scale = 1 } = Astro.props as Props;
const diagramScale = Number.isFinite(scale)
  ? Math.min(Math.max(scale, 0.5), 1)
  : 1;
const annotations = content?.annotations;
const humansAgents = annotations?.humansAgents;
const branchPolicy = annotations?.branchPolicy;
const knownGood = content?.knownGood;
const forkAction = content?.fork;
const forkedBranchDetails = content?.forkedBranch;
const goldenTest = content?.goldenTest;
const capsuleDiff = content?.capsuleDiff;
const promoteAction = content?.promote;
const productionRoute = content?.productionRoute;
const rollback = content?.rollback;
const processRail = content?.processRail;
const knownGoodItemIcons = ["Workflow", "Database", "Route", "History"];

const PROCESS_RAIL_BACKGROUND_Y = 752;
const PROCESS_RAIL_BACKGROUND_HEIGHT = 48;
const PROCESS_RAIL_STAGE_Y = 763;
const PROCESS_RAIL_STAGE_WIDTH = 126;
const PROCESS_RAIL_STAGE_HEIGHT = 26;
const PROCESS_RAIL_STAGE_PADDING = 4;
const PROCESS_RAIL_ICON_SIZE = 18;
const PROCESS_RAIL_ICON_LABEL_GAP = 8;
const PROCESS_RAIL_ICON_Y = 767;
const PROCESS_RAIL_LABEL_Y = 781;
const PROCESS_RAIL_CONNECTOR_Y = 776;

const processRailStageDefinitions = processRail
  ? ([
      {
        id: "fork",
        label: processRail.fork,
        icon: "GitFork",
        tone: "activity",
        iconX: 185,
      },
      {
        id: "edit",
        label: processRail.edit,
        icon: "PencilLine",
        tone: "activity",
        iconX: 355,
      },
      {
        id: "test",
        label: processRail.test,
        icon: "FlaskConical",
        tone: "activity",
        iconX: 525,
      },
      {
        id: "diff",
        label: processRail.diff,
        icon: "FileDiff",
        tone: "production",
        iconX: 695,
      },
      {
        id: "promote",
        label: processRail.promote,
        icon: "ShieldCheck",
        tone: "approval",
        iconX: 865,
      },
      {
        id: "rollback",
        label: processRail.rollback,
        icon: "RotateCcw",
        tone: "rollback",
        iconX: 1035,
      },
    ] as const)
  : [];

const processRailStages = processRailStageDefinitions.map((stage) => {
  const cardX = stage.iconX - PROCESS_RAIL_STAGE_PADDING;
  return {
    ...stage,
    cardX,
    labelX: stage.iconX + PROCESS_RAIL_ICON_SIZE + PROCESS_RAIL_ICON_LABEL_GAP,
  };
});

const firstProcessRailStage = processRailStages[0];
const lastProcessRailStage = processRailStages[processRailStages.length - 1];
const processRailBounds =
  firstProcessRailStage && lastProcessRailStage
    ? {
        x: firstProcessRailStage.cardX,
        width:
          lastProcessRailStage.cardX +
          PROCESS_RAIL_STAGE_WIDTH -
          firstProcessRailStage.cardX,
      }
    : null;

const processRailRelationships = processRailStages.flatMap((stage, index) => {
  const nextStage = processRailStages[index + 1];
  if (!nextStage) return [];
  return [
    {
      id: `${stage.id}-to-${nextStage.id}`,
      stage: nextStage.id,
      tone: nextStage.tone,
      fromX: stage.cardX + PROCESS_RAIL_STAGE_WIDTH,
      toX: nextStage.cardX,
    },
  ];
});

const splitSvgTextLines = (content: string) =>
  content
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean);

const wrapSvgTextLines = (content: string, maxCharacters: number) => {
  const wrappedLines: string[] = [];
  for (const sourceLine of splitSvgTextLines(content)) {
    let currentLine = "";
    for (const word of sourceLine.split(/\s+/)) {
      const candidate = currentLine ? `${currentLine} ${word}` : word;
      if (currentLine && candidate.length > maxCharacters) {
        wrappedLines.push(currentLine);
        currentLine = word;
      } else {
        currentLine = candidate;
      }
    }
    if (currentLine) {
      wrappedLines.push(currentLine);
    }
  }
  return wrappedLines;
};

// Expanding the viewBox creates equal canvas padding without changing diagram coordinates.
const createCenteredViewBox = (
  width: number,
  height: number,
  scaleFactor: number,
) => {
  const scaledWidth = width / scaleFactor;
  const scaledHeight = height / scaleFactor;
  const offsetX = (width - scaledWidth) / 2;
  const offsetY = (height - scaledHeight) / 2;
  return [offsetX, offsetY, scaledWidth, scaledHeight]
    .map((value) => value.toFixed(3))
    .join(" ");
};

const goldenTestTitleLines = goldenTest
  ? wrapSvgTextLines(goldenTest.title, 16)
  : [];
const capsuleDiffTitleLines = capsuleDiff
  ? wrapSvgTextLines(capsuleDiff.title, 15)
  : [];
const productionRouteTitleLines = productionRoute
  ? wrapSvgTextLines(productionRoute.title, 14)
  : [];

const desktopViewBox = createCenteredViewBox(1440, 810, diagramScale);
