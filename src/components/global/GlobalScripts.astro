<script>
  import HSAccordion from "@preline/accordion/non-auto";
  import HSCollapse from "@preline/collapse/non-auto";
  import HSOverlay from "@preline/overlay/non-auto";
  import HSTabs from "@preline/tabs/non-auto";
  import HSScrollspy from "@preline/scrollspy/non-auto";
  import HSDropdown from "@preline/dropdown/non-auto";
  import { animate, inView } from "motion";

  const animationMap = {
    "fade-up-sm": { opacity: [0, 1], y: [30, 0] },
    "fade-down-sm": { opacity: [0, 1], y: [-30, 0] },
    "fade-right-sm": { opacity: [0, 1], x: [-30, 0] },
    "fade-left-sm": { opacity: [0, 1], x: [30, 0] },
    "fade-in": { opacity: [0, 1] },
  };

  const motionObserverCleanups: Array<() => void> = [];
  const horizontalScrollCleanups: Array<() => void> = [];

  let prelineInitialized = false;
  let behaviorInitialized = false;

  function isAnimationName(value: string): value is keyof typeof animationMap {
    return Object.prototype.hasOwnProperty.call(animationMap, value);
  }

  function getNumericAttribute(
    element: Element,
    name: string,
    fallback: number,
    minimum: number,
    maximum = Number.POSITIVE_INFINITY,
  ): number {
    const value = Number.parseFloat(element.getAttribute(name) || "");
    if (!Number.isFinite(value)) {
      return fallback;
    }
    return Math.min(Math.max(value, minimum), maximum);
  }

  function initializePreline() {
    if (prelineInitialized) return;
    HSAccordion.autoInit();
    HSCollapse.autoInit();
    HSOverlay.autoInit();
    HSTabs.autoInit();
    HSScrollspy.autoInit();
    HSDropdown.autoInit();
    prelineInitialized = true;
  }

  function initializeMotionAnimations() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }
    document.querySelectorAll<HTMLElement>("[data-aos]").forEach((element) => {
      const animationName = element.getAttribute("data-aos") || "fade-in";
      const keyframes = isAnimationName(animationName)
        ? animationMap[animationName]
        : animationMap["fade-in"];
      const durationMs = getNumericAttribute(
        element,
        "data-aos-duration",
        700,
        0,
      );
      const amount = getNumericAttribute(
        element,
        "data-aos-overlap",
        0.1,
        0,
        1,
      );
      const delayMs = getNumericAttribute(element, "data-aos-delay", 0, 0);
      const stopObserving = inView(
        element,
        () => {
          animate(element, keyframes, {
            duration: durationMs / 1000,
            delay: delayMs / 1000,
            ease: "easeOut",
          });
        },
        { amount },
      );
      motionObserverCleanups.push(stopObserving);
    });
  }

  function isInsideSceneDeckFrame(element: Element): boolean {
    return element.closest("[data-scene-deck-frame]") !== null;
  }

  function initializeHorizontalScroll() {
    document.querySelectorAll("*").forEach((element) => {
      if (
        !(element instanceof HTMLElement) ||
        isInsideSceneDeckFrame(element) ||
        element.scrollWidth <= element.clientWidth
      ) {
        return;
      }
      const handleWheel = (event: WheelEvent) => {
        if (!event.shiftKey) return;
        event.preventDefault();
        element.scrollBy({
          left: event.deltaY * 3,
          behavior: "smooth",
        });
      };
      element.addEventListener("wheel", handleWheel, { passive: false });
      horizontalScrollCleanups.push(() => {
        element.removeEventListener("wheel", handleWheel);
      });
    });
  }

  function initializeGlobalScripts() {
    initializePreline();
    if (behaviorInitialized) return;
    behaviorInitialized = true;
    initializeMotionAnimations();
    initializeHorizontalScroll();
  }

  function teardownGlobalBehavior() {
    motionObserverCleanups.forEach((cleanup) => cleanup());
    motionObserverCleanups.length = 0;
    horizontalScrollCleanups.forEach((cleanup) => cleanup());
    horizontalScrollCleanups.length = 0;
    behaviorInitialized = false;
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeGlobalScripts, {
      once: true,
    });
  } else {
    initializeGlobalScripts();
  }

  window.addEventListener("pagehide", teardownGlobalBehavior);
  window.addEventListener("pageshow", initializeGlobalScripts);
</script>
