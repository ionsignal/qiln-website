---
import SvgIcon from "@/components/helpers/SvgIcon.astro";
import { formatUrl } from "@/utils/core";
import type { SocialLink } from "@/types";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"ul">, "class" | "title"> {
  class?: string;
  size?: "sm" | "md" | "lg";
  list: SocialLink[];
  linkType?: "share" | "follow";
  layout?: "classic" | "minimal" | "modern";
  slug?: string;
  title?: string;
  description?: string;
  disabled?: string[];
}

interface SocialItem {
  social: SocialLink;
  href: string;
}

const {
  list,
  size = "md",
  title,
  slug,
  disabled,
  layout = "modern",
  linkType = "follow",
  description,
  class: className,
  ...attributes
} = Astro.props;

const formattedSlug = slug ? formatUrl(slug) : "";
const encodedSlug = encodeURIComponent(formattedSlug);
const encodedTitle = encodeURIComponent(title || "");
const encodedDescription = encodeURIComponent(description || "");
const baseUrl = encodeURIComponent(Astro.site?.href ?? Astro.url.origin);

const shareLinks: Record<string, string> = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedSlug}`,
  twitter: `https://twitter.com/intent/tweet/?text=${encodedTitle}&url=${encodedSlug}`,
  linkedin: `https://www.linkedin.com/shareArticle?mini=true&url=${encodedSlug}&title=${encodedTitle}&summary=${encodedDescription}&source=${baseUrl}`,
  pinterest: `https://pinterest.com/pin/create/button/?url=${encodedSlug}&media=&description=${encodedDescription}`,
};

let visibleLinks =
  linkType === "share" ? [...list] : list.filter((social) => social.url);

if (disabled) {
  visibleLinks = visibleLinks.filter(
    (social) => !disabled.includes(social.label),
  );
}

const socialItems: SocialItem[] = visibleLinks.flatMap((social) => {
  const href =
    linkType === "share" ? shareLinks[social.label.toLowerCase()] : social.url;

  return href ? [{ social, href }] : [];
});
---

{
  socialItems.length > 0 && (
    <ul
      class:list={["flex flex-wrap items-center gap-4", className]}
      {...attributes}>
      {socialItems.map(({ social, href }) => (
        <li>
          <a
            aria-label={social.label}
            href={href}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class:list={[
              "group relative flex items-center justify-center transition-all duration-300",
              {
                "text-text-default hover:bg-primary/10 hover:border-primary/40 hover:text-primary hover:shadow-[0_0_15px_--theme(--color-primary/20%)] rounded-full border border-transparent bg-white/5 backdrop-blur-md":
                  layout === "classic",
              },
              {
                "text-text-default hover:text-primary hover:scale-110":
                  layout === "minimal",
              },
              {
                "hover:bg-primary text-text-default hover:text-light rounded-full bg-white/5":
                  layout === "modern",
              },
              {
                "h-12 w-12": size === "sm",
                "h-14 w-14": size === "md",
                "h-16 w-16": size === "lg",
              },
            ]}>
            <span class="sr-only">{social.label}</span>
            {social.icon && (
              <SvgIcon
                icon={social.icon}
                class:list={[
                  "relative z-10 text-inherit transition-colors duration-300",
                  {
                    "h-4 w-4": size === "sm",
                    "h-5 w-5": size === "md",
                    "h-6 w-6": size === "lg",
                  },
                ]}
                aria-hidden="true"
              />
            )}
          </a>
        </li>
      ))}
    </ul>
  )
}
