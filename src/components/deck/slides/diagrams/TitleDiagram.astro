---
import DeckIcon from "@/components/deck/DeckIcon.astro";
import LucideIcon from "@/components/helpers/LucideIcon.astro";

interface Props {
  label: string;
  description: string;
}

const { label, description } = Astro.props;
---

<div
  class="qiln-title-diagram mx-auto w-full max-w-3xl"
  role="img"
  aria-label={`${label}. ${description}`}>
  <div class="title-diagram-stage" aria-hidden="true">
    <svg
      class="title-diagram-connections title-diagram-connections-desktop"
      viewBox="0 0 640 420"
      preserveAspectRatio="none"
      focusable="false">
      <defs>
        <marker
          id="qiln-title-desktop-arrow"
          viewBox="0 0 8 8"
          refX="7"
          refY="4"
          markerWidth="8"
          markerHeight="8"
          markerUnits="userSpaceOnUse"
          orient="auto">
          <path class="title-diagram-arrow" d="M0 0 L8 4 L0 8 Z"></path>
        </marker>
      </defs>
      <path
        class="title-diagram-route-connection"
        d="M305 92 H370"
        vector-effect="non-scaling-stroke">
      </path>
      <path
        class="title-diagram-branch-connection"
        d="M180 150 V210 H400 V260"
        vector-effect="non-scaling-stroke">
      </path>
      <path
        class="title-diagram-editor-connection"
        d="M92 292 H185 V319 H243"
        marker-end="url(#qiln-title-desktop-arrow)"
        vector-effect="non-scaling-stroke">
      </path>
      <path
        class="title-diagram-editor-connection"
        d="M92 346 H185 V319"
        vector-effect="non-scaling-stroke">
      </path>
    </svg>
    <article class="title-diagram-card known-good-card">
      <DeckIcon icon="ShieldCheck" />
      <div class="title-diagram-card-copy">
        <span class="title-diagram-kicker">CAPSULE</span>
        <h3 class="title-diagram-card-title">
          Known-Good
          <span>Capsule v1.0</span>
        </h3>
      </div>
      <span class="known-good-status">
        <LucideIcon
          icon="Check"
          stroke-width="1"
          class="h-5 w-5"
          aria-hidden="true"
        />
      </span>
    </article>
    <article class="title-diagram-card stable-route-card">
      <DeckIcon icon="LockKeyhole" color="secondary" />
      <div class="title-diagram-card-copy">
        <span class="title-diagram-kicker title-diagram-kicker-stable">
          STABLE
        </span>
        <h3 class="title-diagram-card-title">
          Known-Good <span>Route v1.0</span>
        </h3>
      </div>
    </article>
    <div class="title-diagram-editors">
      <DeckIcon icon="UserRound" label="human" />
      <DeckIcon icon="Bot" label="agent" />
    </div>
    <article class="title-diagram-card forked-branch-card">
      <DeckIcon icon="GitFork" />
      <div class="title-diagram-card-copy">
        <span class="title-diagram-kicker title-diagram-kicker-branch">
          ISOLATED FORK
        </span>
        <h3 class="title-diagram-card-title">
          Forked Branch
          <span>v1.1</span>
        </h3>
      </div>
    </article>
  </div>
</div>

<style>
  .qiln-title-diagram {
    container-type: inline-size;
  }

  .title-diagram-stage {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: clamp(18.5rem, 65cqw, 24rem);
    margin-inline: auto;
  }

  .title-diagram-stage::before {
    position: absolute;
    z-index: -1;
    inset: 8% 4%;
    background:
      radial-gradient(
        circle at 48% 36%,
        color-mix(in srgb, var(--color-primary) 15%, transparent),
        transparent 48%
      ),
      radial-gradient(
        circle at 78% 28%,
        color-mix(in srgb, var(--color-secondary) 10%, transparent),
        transparent 34%
      );
    filter: blur(18px);
    content: "";
  }

  .title-diagram-connections {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    pointer-events: none;
  }

  .title-diagram-connections-desktop {
    display: block;
  }

  .title-diagram-route-connection,
  .title-diagram-branch-connection,
  .title-diagram-editor-connection {
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .title-diagram-route-connection {
    stroke: color-mix(in srgb, var(--color-secondary) 86%, transparent);
    stroke-width: 2px;
  }

  .title-diagram-branch-connection {
    stroke: color-mix(in srgb, var(--color-primary) 88%, transparent);
    stroke-width: 2px;
  }

  .title-diagram-editor-connection {
    stroke: color-mix(in srgb, var(--color-primary) 88%, transparent);
    stroke-dasharray: 4 5;
    stroke-width: 1.5px;
  }

  .title-diagram-arrow {
    fill: var(--color-primary);
  }

  .title-diagram-card {
    position: absolute;
    z-index: 2;
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 15px;
    border: 1px solid color-mix(in srgb, var(--color-light) 24%, transparent);
    border-radius: clamp(0.75rem, 2cqw, 1rem);
    background:
      radial-gradient(
        circle at 74% 36%,
        color-mix(in srgb, var(--color-primary) 9%, transparent),
        transparent 48%
      ),
      color-mix(in srgb, var(--color-theme-dark) 92%, transparent);
    padding: 0 15px;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 18px 36px rgb(0 0 0 / 0.2);
  }

  .title-diagram-card-copy {
    display: grid;
    min-width: 0;
    flex: 1;
    gap: clamp(0.1875rem, 0.7cqw, 0.3125rem);
  }

  .title-diagram-kicker {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: clamp(0.525rem, 1.45cqw, 0.75rem);
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 0.875rem;
  }

  .title-diagram-card-title {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--color-light);
    font-family: var(--font-secondary);
    font-size: clamp(0.7125rem, 2.85cqw, 1.25rem);

    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.12;
  }

  .title-diagram-card-title span {
    color: inherit;
  }

  .known-good-card {
    top: 8%;
    left: 0;
    width: 48%;
    height: 28%;
    border-color: color-mix(in srgb, var(--color-light) 30%, transparent);
  }

  .known-good-status {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: clamp(1.875rem, 6cqw, 2.5rem);
    height: clamp(1.875rem, 6cqw, 2.5rem);
    margin-left: auto;
    border: 2px solid
      color-mix(in srgb, var(--color-secondary) 82%, transparent);
    border-radius: 9999px;
    color: var(--color-secondary);
    background: color-mix(in srgb, var(--color-secondary) 6%, transparent);
  }

  @container (max-width: 28rem) {
    .known-good-status {
      display: none;
    }
  }

  .stable-route-card {
    top: 8%;
    right: 0;
    width: 42%;
    height: 28%;
    border-color: color-mix(in srgb, var(--color-secondary) 58%, transparent);
    background:
      radial-gradient(
        circle at 22% 50%,
        color-mix(in srgb, var(--color-secondary) 12%, transparent),
        transparent 58%
      ),
      color-mix(in srgb, var(--color-theme-dark) 92%, transparent);
  }

  @container (max-width: 28rem) {
    .stable-route-card > span {
      display: none !important;
    }
  }

  .title-diagram-kicker-stable {
    color: var(--color-secondary);
  }

  .title-diagram-editors {
    position: absolute;
    z-index: 2;
    top: 76%;
    left: 0;
    display: grid;
    width: 21%;
    justify-items: center;
    gap: clamp(0.375rem, 1cqw, 0.5rem);
    transform: translateY(-50%);
  }

  .forked-branch-card {
    top: 62%;
    right: auto;
    left: 38%;
    width: 50%;
    height: 28%;
    overflow: hidden;
    border-color: color-mix(in srgb, var(--color-primary) 58%, transparent);
    background:
      radial-gradient(
        circle at 20% 50%,
        color-mix(in srgb, var(--color-primary) 13%, transparent),
        transparent 62%
      ),
      color-mix(in srgb, var(--color-theme-dark) 92%, transparent);
  }

  .forked-branch-card::after {
    position: absolute;
    inset: clamp(0.375rem, 1.4cqw, 0.625rem);
    border: 1px dashed color-mix(in srgb, var(--color-primary) 62%, transparent);
    border-radius: 0.625rem;
    pointer-events: none;
    content: "";
  }

  .forked-branch-card > * {
    position: relative;
    z-index: 1;
  }

  .title-diagram-kicker-branch {
    color: color-mix(in srgb, var(--color-primary) 82%, var(--color-light));
  }
</style>
