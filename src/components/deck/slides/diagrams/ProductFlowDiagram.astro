<style>
  .product-diagram {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
  }

  .product-diagram svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .product-diagram-mobile {
    display: block;
    max-width: 25rem;
    margin-inline: auto;
  }

  .product-diagram-desktop {
    display: none;
  }

  .diagram-card,
  .diagram-capsule-layer,
  .diagram-isolation-lane,
  .diagram-version-pill {
    vector-effect: non-scaling-stroke;
  }

  .diagram-card {
    fill: color-mix(in srgb, var(--color-theme-dark) 94%, transparent);
    stroke: color-mix(in srgb, var(--color-light) 20%, transparent);
    stroke-width: 1;
  }

  .diagram-capsule-card,
  .diagram-fork-card {
    stroke: color-mix(in srgb, var(--color-primary) 52%, transparent);
  }

  .diagram-route-card,
  .diagram-gate-card {
    stroke: color-mix(in srgb, var(--color-secondary) 52%, transparent);
  }

  .diagram-gate-card {
    stroke-width: 1.5;
  }

  .diagram-step-card {
    fill: color-mix(in srgb, var(--color-body) 70%, transparent);
    stroke: color-mix(in srgb, var(--color-light) 16%, transparent);
  }

  .diagram-capsule-layer {
    fill: color-mix(in srgb, var(--color-primary) 4%, transparent);
    stroke: color-mix(in srgb, var(--color-primary) 26%, transparent);
    stroke-width: 1;
  }

  .diagram-isolation-lane {
    fill: color-mix(in srgb, var(--color-primary) 2.5%, transparent);
    stroke: color-mix(in srgb, var(--color-primary) 34%, transparent);
    stroke-width: 1;
    stroke-dasharray: 7 8;
  }

  .diagram-line {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .diagram-stable-line,
  .diagram-promotion-line {
    stroke: var(--color-secondary);
    stroke-width: 2;
  }

  .diagram-fork-line {
    stroke: color-mix(in srgb, var(--color-primary) 78%, transparent);
    stroke-width: 1.5;
    stroke-dasharray: 6 7;
  }

  .diagram-rollback-line {
    stroke: color-mix(in srgb, var(--color-text-default) 56%, transparent);
    stroke-width: 1.25;
    stroke-dasharray: 2 5;
  }

  .diagram-marker-primary {
    fill: var(--color-primary);
  }

  .diagram-marker-secondary {
    fill: var(--color-secondary);
  }

  .diagram-marker-neutral {
    fill: color-mix(in srgb, var(--color-text-default) 72%, transparent);
  }

  .diagram-label-backplate {
    fill: var(--color-theme-dark);
  }

  .diagram-version-pill {
    fill: color-mix(in srgb, var(--color-secondary) 8%, transparent);
    stroke: color-mix(in srgb, var(--color-secondary) 38%, transparent);
    stroke-width: 1;
  }

  .diagram-status-dot {
    fill: var(--color-secondary);
  }

  .diagram-kicker,
  .diagram-lane-label,
  .diagram-rail-label,
  .diagram-step-number,
  .diagram-version-text {
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .diagram-kicker {
    fill: var(--color-primary);
    font-size: 12px;
    letter-spacing: 0.11em;
  }

  .diagram-kicker-secondary {
    fill: var(--color-secondary);
  }

  .diagram-title,
  .diagram-lane-title,
  .diagram-step-title {
    fill: var(--color-light);
    font-family: var(--font-secondary);
    font-weight: 500;
  }

  .diagram-title {
    font-size: 19px;
    letter-spacing: 0.01em;
  }

  .diagram-lane-title {
    font-size: 17px;
  }

  .diagram-step-title {
    font-size: 17px;
  }

  .diagram-detail {
    fill: var(--color-text-default);
    font-family: var(--font-primary);
    font-size: 13px;
    font-weight: 400;
  }

  .diagram-lane-label {
    fill: color-mix(in srgb, var(--color-primary) 88%, var(--color-light));
    font-size: 11px;
    letter-spacing: 0.12em;
  }

  .diagram-rail-label {
    fill: var(--color-text-default);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .diagram-rail-label-secondary {
    fill: var(--color-secondary);
  }

  .diagram-step-number {
    fill: var(--color-primary);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .diagram-version-text {
    fill: var(--color-secondary);
    font-size: 11px;
  }

  @media (min-width: 768px) {
    .product-diagram-desktop-md .product-diagram-mobile {
      display: none;
    }

    .product-diagram-desktop-md .product-diagram-desktop {
      display: block;
    }
  }

  @media (min-width: 1024px) {
    .product-diagram-desktop-lg .product-diagram-mobile {
      display: none;
    }

    .product-diagram-desktop-lg .product-diagram-desktop {
      display: block;
    }
  }
</style>
