---
import DeckIcon from "@/components/deck/DeckIcon.astro";
import LucideIcon from "@/components/helpers/LucideIcon.astro";
---

<div class="product-flow mx-auto w-full" aria-hidden="true">
  <div class="product-flow-stage">
    <svg
      class="product-flow-connector-layer"
      viewBox="0 0 1200 400"
      preserveAspectRatio="none"
      focusable="false"
      aria-hidden="true">
      <defs>
        <linearGradient
          id="product-flow-promotion-gradient"
          x1="100%"
          y1="100%"
          x2="0%"
          y2="0%">
          <stop offset="0" stop-color="var(--color-primary)"></stop>
          <stop offset="1" stop-color="var(--color-secondary)"></stop>
        </linearGradient>
        <marker
          id="product-flow-arrow-primary"
          markerWidth="6"
          markerHeight="6"
          refX="5.5"
          refY="3"
          orient="auto"
          markerUnits="strokeWidth"
          viewBox="0 0 6 6">
          <path class="product-flow-arrow-marker--primary" d="M0 0 L6 3 L0 6 Z">
          </path>
        </marker>
        <marker
          id="product-flow-arrow-secondary"
          markerWidth="6"
          markerHeight="6"
          refX="5.5"
          refY="3"
          orient="auto"
          markerUnits="strokeWidth"
          viewBox="0 0 6 6">
          <path
            class="product-flow-arrow-marker--secondary"
            d="M0 0 L6 3 L0 6 Z">
          </path>
        </marker>
        <marker
          id="product-flow-arrow-muted"
          markerWidth="6"
          markerHeight="6"
          refX="5.5"
          refY="3"
          orient="auto"
          markerUnits="strokeWidth"
          viewBox="0 0 6 6">
          <path class="product-flow-arrow-marker--muted" d="M0 0 L6 3 L0 6 Z">
          </path>
        </marker>
      </defs>

      <g
        class="product-flow-connectors--wide"
        data-product-flow-connector-paths>
        <path
          class="product-flow-connector product-flow-connector--rollback"
          d="M970 108 C870 18 575 8 455 50"
          marker-end="url(#product-flow-arrow-muted)"
          vector-effect="non-scaling-stroke">
        </path>
        <path
          class="product-flow-connector product-flow-connector--primary"
          d="M345 112 L345 248"
          marker-end="url(#product-flow-arrow-primary)"
          vector-effect="non-scaling-stroke">
        </path>
        <path
          class="product-flow-connector product-flow-connector--primary"
          d="M477 315 H504"
          marker-end="url(#product-flow-arrow-primary)"
          vector-effect="non-scaling-stroke">
        </path>
        <path
          class="product-flow-connector product-flow-connector--primary"
          d="M717 315 H744"
          marker-end="url(#product-flow-arrow-primary)"
          vector-effect="non-scaling-stroke">
        </path>
        <path
          class="product-flow-connector product-flow-connector--primary"
          d="M960 315 H987"
          marker-end="url(#product-flow-arrow-primary)"
          vector-effect="non-scaling-stroke">
        </path>
        <path
          class="product-flow-connector product-flow-connector--promotion"
          d="M1202 320 H1220 V164 H1130"
          marker-end="url(#product-flow-arrow-secondary)"
          vector-effect="non-scaling-stroke">
        </path>
        <g class="product-flow-arrow-label" transform="translate(345 184)">
          <rect x="-24" y="-10" width="48" height="20" rx="10"></rect>
          <text>fork</text>
        </g>
        <g class="product-flow-arrow-label" transform="translate(1215 218)">
          <rect x="-30" y="-10" width="60" height="20" rx="10"></rect>
          <text>promote</text>
        </g>
        <g
          class="product-flow-arrow-label product-flow-arrow-label--muted"
          transform="translate(680 31)">
          <rect x="-39" y="-10" width="78" height="20" rx="10"></rect>
          <text>rollback</text>
        </g>
      </g>

      <svg
        class="product-flow-connectors--compact"
        data-product-flow-connector-paths
        x="0"
        y="0"
        width="1200"
        height="400"
        viewBox="0 0 700 400"
        preserveAspectRatio="none">
        <path
          class="product-flow-connector product-flow-connector--rollback"
          d="M480 118 C410 18 315 8 222 50"
          marker-end="url(#product-flow-arrow-muted)"
          vector-effect="non-scaling-stroke">
        </path>
        <path
          class="product-flow-connector product-flow-connector--primary"
          d="M142 112 V240"
          marker-end="url(#product-flow-arrow-primary)"
          vector-effect="non-scaling-stroke">
        </path>
        <path
          class="product-flow-connector product-flow-connector--primary"
          d="M207 315 H229"
          marker-end="url(#product-flow-arrow-primary)"
          vector-effect="non-scaling-stroke">
        </path>
        <path
          class="product-flow-connector product-flow-connector--primary"
          d="M371 315 H392"
          marker-end="url(#product-flow-arrow-primary)"
          vector-effect="non-scaling-stroke">
        </path>
        <path
          class="product-flow-connector product-flow-connector--primary"
          d="M536 315 H555"
          marker-end="url(#product-flow-arrow-primary)"
          vector-effect="non-scaling-stroke">
        </path>
        <path
          class="product-flow-connector product-flow-connector--promotion"
          d="M628 265 V220"
          marker-end="url(#product-flow-arrow-primary)"
          vector-effect="non-scaling-stroke">
        </path>
        <g class="product-flow-arrow-label" transform="translate(140 184)">
          <rect x="-24" y="-10" width="48" height="20" rx="10"></rect>
          <text>fork</text>
        </g>
        <g class="product-flow-arrow-label" transform="translate(628 241)">
          <rect x="-30" y="-10" width="60" height="20" rx="10"></rect>
          <text>promote</text>
        </g>
        <g
          class="product-flow-arrow-label product-flow-arrow-label--muted"
          transform="translate(352 31)">
          <rect x="-39" y="-10" width="78" height="20" rx="10"></rect>
          <text>rollback</text>
        </g>
      </svg>
    </svg>

    <div class="product-flow-label product-flow-label--production">
      <span>Live production</span>
    </div>

    <article
      class="product-route-card product-route-card--current"
      aria-label="Current live stable route pointing to approved capsule version 42">
      <DeckIcon
        icon="LockKeyhole"
        color="secondary"
        class="product-route-icon"
      />
      <div class="product-route-copy">
        <span class="product-card-kicker product-card-kicker--stable">
          LIVE
        </span>
        <h3 class="product-route-title">Stable Route</h3>
        <p class="product-route-mapping">
          <code>/generate</code>
          <span>→</span>
          <span>Capsule</span>
          <code>v42</code>
        </p>
      </div>
    </article>

    <div class="product-flow-label product-flow-label--change">
      <span>Safe change path</span>
    </div>

    <div class="product-fork-system">
      <div class="product-editors">
        <DeckIcon icon="UserRound" label="human" class="product-editor" />
        <DeckIcon icon="Bot" label="agent" class="product-editor" />
      </div>

      <div class="product-fork-capsule">
        <span class="product-fork-layer"></span>
        <article class="product-fork-card">
          <DeckIcon icon="GitFork" class="product-fork-icon" />
          <div class="product-fork-copy">
            <span class="product-card-kicker">ISOLATED FORK</span>
            <h3 class="product-fork-title">Capsule <code>v43</code></h3>
            <p>Edit in isolation</p>
          </div>
        </article>
      </div>
    </div>

    <article class="product-flow-step product-flow-step--test">
      <LucideIcon
        icon="FlaskConical"
        class="product-step-icon"
        aria-hidden="true"
        stroke-width="1.5"
      />
      <span class="product-card-kicker">RUN</span>
      <h3>Test</h3>
      <p>Golden test</p>
    </article>

    <article class="product-flow-step product-flow-step--diff">
      <LucideIcon
        icon="FileDiff"
        class="product-step-icon"
        aria-hidden="true"
        stroke-width="1.5"
      />
      <span class="product-card-kicker">REVIEW</span>
      <h3>Diff</h3>
      <p>Inspect change</p>
    </article>

    <article class="product-flow-step product-flow-step--approval">
      <LucideIcon
        icon="ShieldCheck"
        class="product-step-icon"
        aria-hidden="true"
        stroke-width="1.5"
      />
      <span class="product-card-kicker">ONLY REJOIN POINT</span>
      <h3>Approval</h3>
      <p>Human or policy</p>
    </article>

    <article
      class="product-route-card product-route-card--candidate"
      aria-label="Promoted stable route pointing to approved capsule version 43">
      <DeckIcon
        icon="ShieldCheck"
        color="secondary"
        class="product-route-icon"
      />
      <div class="product-route-copy">
        <span class="product-card-kicker product-card-kicker--stable">
          AFTER APPROVAL
        </span>
        <h3 class="product-route-title">Stable Route</h3>
        <p class="product-route-mapping">
          <code>/generate</code>
          <span>→</span>
          <span>Capsule</span>
          <code>v43</code>
        </p>
      </div>
    </article>
  </div>
</div>

<style>
  .product-flow {
    width: 100%;
    max-width: 72rem;
    container-type: inline-size;
    --product-flow-gap: clamp(1rem, 2.25cqw, 2.5rem);
    --product-flow-row-gap: 0.5rem;
    --product-route-offset: 5rem;
    --product-flow-approval-clearance: clamp(0.75rem, 1.5cqw, 1.25rem);
  }

  .product-flow-stage {
    position: relative;
    isolation: isolate;
    display: grid;
    width: 100%;
    min-height: 20rem;
    grid-template-columns: minmax(0, 1.45fr) repeat(3, minmax(0, 1fr));
    grid-template-rows:
      var(--product-route-offset)
      auto
      auto
      var(--product-flow-approval-clearance)
      auto;
    column-gap: var(--product-flow-gap);
    row-gap: var(--product-flow-row-gap);
    align-content: center;
    align-items: center;
    padding-top: 0.5rem;
  }

  .product-flow-stage::before {
    position: absolute;
    z-index: 0;
    inset: 12% 5%;
    background:
      radial-gradient(
        circle at 30% 62%,
        color-mix(in srgb, var(--color-primary) 9%, transparent),
        transparent 38%
      ),
      radial-gradient(
        circle at 74% 32%,
        color-mix(in srgb, var(--color-secondary) 8%, transparent),
        transparent 34%
      );
    filter: blur(20px);
    content: "";
  }

  .product-flow-connector-layer {
    position: absolute;
    z-index: 0;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .product-flow-connectors--compact {
    display: block;
  }

  .product-flow-connectors--wide {
    display: none;
  }

  .product-flow-connector {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5px;
  }

  .product-flow-connector--primary {
    stroke: color-mix(in srgb, var(--color-primary) 86%, transparent);
  }

  .product-flow-connector--rollback {
    stroke: color-mix(in srgb, var(--color-text-default) 62%, transparent);
    stroke-dasharray: 5 6;
  }

  .product-flow-connector--promotion {
    stroke: url(#product-flow-promotion-gradient);
    stroke-width: 1.75px;
  }

  .product-flow-connectors--compact .product-flow-connector--promotion {
    stroke: var(--color-primary);
  }

  .product-flow-arrow-marker--primary {
    fill: var(--color-primary);
  }

  .product-flow-arrow-marker--secondary {
    fill: var(--color-secondary);
  }

  .product-flow-arrow-marker--muted {
    fill: color-mix(in srgb, var(--color-text-default) 68%, transparent);
  }

  .product-flow-arrow-label {
    pointer-events: none;
  }

  .product-flow-arrow-label rect {
    fill: color-mix(in srgb, var(--color-theme-dark) 96%, transparent);
    stroke: color-mix(in srgb, var(--color-primary) 38%, transparent);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }

  .product-flow-arrow-label text {
    fill: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .product-flow-arrow-label--muted rect {
    stroke: color-mix(in srgb, var(--color-text-default) 30%, transparent);
  }

  .product-flow-arrow-label--muted text {
    fill: color-mix(in srgb, var(--color-text-default) 76%, transparent);
  }

  .product-flow-stage > :not(.product-flow-connector-layer) {
    position: relative;
    z-index: 1;
  }

  .product-flow-label {
    display: none;
  }

  .product-route-card,
  .product-fork-card,
  .product-flow-step {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 16px 36px rgb(0 0 0 / 0.16);
  }

  .product-route-card {
    display: grid;
    width: min(16rem, 100%);
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    justify-self: start;
    gap: 0.875rem;
    border: 1px solid
      color-mix(in srgb, var(--color-secondary) 64%, transparent);
    border-radius: 0.875rem;
    background:
      radial-gradient(
        circle at 16% 72%,
        color-mix(in srgb, var(--color-secondary) 13%, transparent),
        transparent 50%
      ),
      color-mix(in srgb, var(--color-theme-dark) 94%, transparent);
    padding: 1rem;
  }

  .product-route-card--current {
    grid-column: 1;
    grid-row: 1 / 3;
    align-self: start;
  }

  .product-route-card--candidate {
    grid-column: 3 / 5;
    grid-row: 3;
    align-self: start;
    justify-self: center;
    border-width: 1.5px;
    background:
      radial-gradient(
        circle at 78% 32%,
        color-mix(in srgb, var(--color-secondary) 15%, transparent),
        transparent 50%
      ),
      color-mix(in srgb, var(--color-theme-dark) 94%, transparent);
  }

  .product-route-card :global(.deck-icon-wrap) {
    width: 3rem;
    height: 3rem;
    border-color: color-mix(in srgb, var(--color-secondary) 44%, transparent);
    border-radius: 0.625rem;
    background: color-mix(in srgb, var(--color-secondary) 9%, transparent);
  }

  .product-route-card :global(.deck-icon-glyph) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .product-route-copy,
  .product-fork-copy {
    display: grid;
    min-width: 0;
    gap: 0.25rem;
  }

  .product-card-kicker {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    line-height: 0.875rem;
  }

  .product-card-kicker--stable {
    color: var(--color-secondary);
  }

  .product-route-title,
  .product-fork-title,
  .product-flow-step h3 {
    margin: 0;
    color: var(--color-light);
    font-family: var(--font-secondary);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .product-route-title {
    font-size: clamp(0.75rem, 1.25cqw, 1rem);
    line-height: 1.1;
  }

  .product-route-mapping {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem;
    margin: 0.125rem 0 0;
    color: var(--color-text-default);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1rem;
  }

  .product-route-mapping code,
  .product-fork-title code {
    color: var(--color-light);
    font-family: inherit;
    font-weight: inherit;
  }

  .product-fork-system {
    display: grid;
    min-width: 0;
    min-height: 8.25rem;
    grid-column: 1;
    grid-row: 5;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
  }

  .product-editors {
    display: flex;
    grid-column: 1;
    grid-row: 1;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
  }

  .product-editor :global(.deck-icon-wrap) {
    width: 3rem;
    height: 3rem;
    border-color: color-mix(in srgb, var(--color-primary) 46%, transparent);
    border-radius: 0.625rem;
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }

  .product-editor :global(.deck-icon-glyph) {
    width: 1rem;
    height: 1rem;
  }

  .product-editor :global(.deck-icon-label) {
    color: var(--color-primary);
    font-size: 0.575rem;
  }

  .product-fork-capsule {
    position: relative;
    min-width: 0;
    grid-column: 2;
    grid-row: 1;
  }

  .product-fork-layer {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--color-primary) 28%, transparent);
    border-radius: 0.875rem;
    background: color-mix(in srgb, var(--color-primary) 3%, transparent);
    transform: translate(0.35rem, -0.35rem);
  }

  .product-fork-card {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 8.25rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    border: 1.5px solid
      color-mix(in srgb, var(--color-primary) 62%, transparent);
    border-radius: 0.875rem;
    background:
      radial-gradient(
        circle at 20% 60%,
        color-mix(in srgb, var(--color-primary) 13%, transparent),
        transparent 58%
      ),
      color-mix(in srgb, var(--color-theme-dark) 94%, transparent);
    padding: 1rem;
  }

  .product-fork-icon {
    display: none;
  }

  .product-fork-icon :global(.deck-icon-wrap) {
    width: 3rem;
    height: 3rem;
    border-color: color-mix(in srgb, var(--color-primary) 44%, transparent);
    border-radius: 0.625rem;
    background: color-mix(in srgb, var(--color-primary) 9%, transparent);
  }

  .product-fork-icon :global(.deck-icon-glyph) {
    width: 1.2rem;
    height: 1.2rem;
  }

  .product-fork-title {
    font-size: clamp(0.75rem, 1.25cqw, 1rem);
    line-height: 1.1;
  }

  .product-fork-copy p,
  .product-flow-step p {
    margin: 0.125rem 0 0;
    color: var(--color-text-default);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1rem;
  }

  .product-flow-step {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 6.5rem;
    align-content: center;
    justify-items: center;
    gap: 0.2rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 46%, transparent);
    border-radius: 0.75rem;
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--color-primary) 7%, transparent),
        transparent
      ),
      color-mix(in srgb, var(--color-theme-dark) 92%, transparent);
    padding: 0.75rem;
    text-align: center;
  }

  .product-flow-step h3 {
    font-size: clamp(0.75rem, 1.25cqw, 1rem);
    line-height: 1.1;
  }

  .product-step-icon {
    display: block;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-primary);
  }

  .product-flow-step--test {
    grid-column: 2;
    grid-row: 5;
  }

  .product-flow-step--diff {
    grid-column: 3;
    grid-row: 5;
  }

  .product-flow-step--approval {
    grid-column: 4;
    grid-row: 5;
    border-color: color-mix(in srgb, var(--color-primary) 62%, transparent);
    background:
      radial-gradient(
        circle at 76% 26%,
        color-mix(in srgb, var(--color-primary) 11%, transparent),
        transparent 52%
      ),
      color-mix(in srgb, var(--color-theme-dark) 94%, transparent);
  }

  .product-flow-step--approval .product-step-icon {
    color: var(--color-primary);
  }

  @container (min-width: 52rem) {
    .product-flow-stage {
      grid-template-columns:
        minmax(6.75rem, 0.65fr) minmax(14.5rem, 1.45fr)
        repeat(3, minmax(0, 1fr));
    }

    .product-flow-connectors--compact {
      display: none;
    }

    .product-flow-connectors--wide {
      display: inline;
    }

    .product-flow-label {
      display: flex;
      min-width: 0;
      align-self: center;
      align-items: center;
      font-family: var(--font-mono);
      font-size: 0.625rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      line-height: 0.875rem;
      white-space: nowrap;
      text-transform: uppercase;
    }

    .product-flow-label--production {
      grid-column: 1;
      grid-row: 1 / 3;
      align-self: center;
      color: var(--color-secondary);
    }

    .product-flow-label--change {
      grid-column: 1;
      grid-row: 5;
      color: var(--color-primary);
    }

    .product-route-card--current {
      width: 90%;
      grid-column: 2;
    }

    .product-route-card--candidate {
      grid-column: 4 / 6;
    }

    .product-fork-system {
      grid-column: 2;
    }

    .product-fork-card {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .product-fork-icon {
      display: inline-grid;
    }

    .product-editor :global(.deck-icon-wrap) {
      width: 2.8rem;
      height: 2.8rem;
    }

    .product-flow-step--test {
      grid-column: 3;
    }

    .product-flow-step--diff {
      grid-column: 4;
    }

    .product-flow-step--approval {
      grid-column: 5;
    }
  }

  @container (max-width: 26rem) {
    .product-flow :global(.deck-icon) {
      display: none;
    }

    .product-route-card {
      min-height: 5rem;
      gap: 0;
      border-radius: 0.625rem;
      padding: 0.625rem;
    }

    .product-route-icon,
    .product-fork-icon,
    .product-step-icon {
      display: none;
    }

    .product-route-copy,
    .product-fork-copy {
      gap: 0.125rem;
    }

    .product-card-kicker {
      font-size: 0.5rem;
      letter-spacing: 0.07em;
      line-height: 0.625rem;
    }

    .product-route-title,
    .product-fork-title,
    .product-flow-step h3 {
      font-size: 0.6875rem;
    }

    .product-route-mapping {
      gap: 0.2rem;
      margin-top: 0;
      font-size: 0.5625rem;
      line-height: 0.8125rem;
    }

    .product-fork-system {
      gap: 0.375rem;
    }

