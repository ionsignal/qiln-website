---
import LucideIcon from "@/components/helpers/LucideIcon.astro";
---

<div class="product-flow-diagram" aria-hidden="true">
  <div class="product-flow-stage">
    <svg
      class="product-flow-connections"
      viewBox="0 0 1200 560"
      preserveAspectRatio="none"
      focusable="false">
      <defs>
        <marker
          id="qiln-product-flow-primary-arrow"
          viewBox="0 0 8 8"
          refX="7"
          refY="4"
          markerWidth="8"
          markerHeight="8"
          markerUnits="userSpaceOnUse"
          orient="auto">
          <path class="product-flow-marker-primary" d="M0 0 L8 4 L0 8 Z"></path>
        </marker>
        <marker
          id="qiln-product-flow-secondary-arrow"
          viewBox="0 0 8 8"
          refX="7"
          refY="4"
          markerWidth="8"
          markerHeight="8"
          markerUnits="userSpaceOnUse"
          orient="auto">
          <path class="product-flow-marker-secondary" d="M0 0 L8 4 L0 8 Z">
          </path>
        </marker>
        <marker
          id="qiln-product-flow-neutral-arrow"
          viewBox="0 0 8 8"
          refX="7"
          refY="4"
          markerWidth="8"
          markerHeight="8"
          markerUnits="userSpaceOnUse"
          orient="auto">
          <path class="product-flow-marker-neutral" d="M0 0 L8 4 L0 8 Z"></path>
        </marker>
      </defs>

      <path
        class="product-flow-connection product-flow-connection-primary"
        d="M360 156 V350"
        marker-end="url(#qiln-product-flow-primary-arrow)"
        vector-effect="non-scaling-stroke">
      </path>
      <path
        class="product-flow-connection product-flow-connection-primary"
        d="M520 417 H580"
        marker-end="url(#qiln-product-flow-primary-arrow)"
        vector-effect="non-scaling-stroke">
      </path>
      <path
        class="product-flow-connection product-flow-connection-primary"
        d="M715 417 H770"
        marker-end="url(#qiln-product-flow-primary-arrow)"
        vector-effect="non-scaling-stroke">
      </path>
      <path
        class="product-flow-connection product-flow-connection-primary"
        d="M925 417 H980"
        marker-end="url(#qiln-product-flow-primary-arrow)"
        vector-effect="non-scaling-stroke">
      </path>
      <path
        class="product-flow-connection product-flow-connection-secondary"
        d="M1062 360 V300"
        marker-end="url(#qiln-product-flow-secondary-arrow)"
        vector-effect="non-scaling-stroke">
      </path>
      <path
        class="product-flow-connection product-flow-connection-rollback"
        d="M1015 190 V138 C1015 100 840 102 688 102"
        marker-end="url(#qiln-product-flow-neutral-arrow)"
        vector-effect="non-scaling-stroke">
      </path>
    </svg>

    <span class="product-flow-lane-label product-flow-live-label">
      Live production
    </span>

    <article
      class="product-flow-card product-flow-route product-flow-route--source">
      <span class="product-flow-route-status">
        <span class="product-flow-route-shield">
          <LucideIcon
            icon="Shield"
            class="product-flow-route-shield-icon"
            aria-hidden="true"
          />
          <LucideIcon
            icon="LockKeyhole"
            class="product-flow-route-lock-icon"
            aria-hidden="true"
          />
        </span>
        <span class="product-flow-route-status-label">Live</span>
      </span>
      <span class="product-flow-route-title">
        <span>Stable Route →</span>
        <span>Approved Capsule v4.2</span>
      </span>
    </article>

    <div class="product-flow-mobile-fork-connector">
      <span>Fork</span>
      <LucideIcon
        icon="ArrowDown"
        class="product-flow-mobile-connector-icon"
        aria-hidden="true"
      />
    </div>

    <span class="product-flow-lane-label product-flow-safe-label">
      Safe change path
    </span>

    <span class="product-flow-action-label product-flow-fork-label">Fork</span>

    <article class="product-flow-card product-flow-fork">
      <span class="product-flow-fork-actors">
        <span class="product-flow-fork-actor">
          <LucideIcon
            icon="UserRound"
            class="product-flow-fork-user-icon"
            aria-hidden="true"
          />
        </span>
        <span class="product-flow-fork-actor product-flow-fork-actor--agent">
          <LucideIcon
            icon="Bot"
            class="product-flow-fork-bot-icon"
            aria-hidden="true"
          />
        </span>
      </span>
      <span class="product-flow-card-copy">
        <span class="product-flow-card-kicker">Isolated fork</span>
        <span class="product-flow-card-title">Forked Capsule v4.3</span>
        <span class="product-flow-card-detail">Human or agent edits here</span>
      </span>
    </article>

    <article class="product-flow-card product-flow-step product-flow-test">
      <span class="product-flow-step-icon">
        <LucideIcon
          icon="FlaskConical"
          class="product-flow-icon"
          aria-hidden="true"
        />
      </span>
      <span class="product-flow-step-title">Test</span>
    </article>

    <article class="product-flow-card product-flow-step product-flow-diff">
      <span class="product-flow-step-icon">
        <LucideIcon
          icon="FileDiff"
          class="product-flow-icon"
          aria-hidden="true"
        />
      </span>
      <span class="product-flow-step-title">Capsule Diff</span>
    </article>

    <article class="product-flow-card product-flow-step product-flow-approval">
      <span class="product-flow-approval-icon">
        <LucideIcon
          icon="UserRound"
          class="product-flow-icon"
          aria-hidden="true"
        />
        <span class="product-flow-approval-check">
          <LucideIcon
            icon="Check"
            class="product-flow-approval-check-icon"
            aria-hidden="true"
          />
        </span>
      </span>
      <span class="product-flow-step-title">Approval</span>
      <span class="product-flow-step-detail">Human or policy</span>
    </article>

    <span class="product-flow-action-label product-flow-promote-label">
      Promote
    </span>

    <div class="product-flow-mobile-promote-connector">
      <span>Promote</span>
      <LucideIcon
        icon="ArrowDown"
        class="product-flow-mobile-connector-icon"
        aria-hidden="true"
      />
    </div>

    <article
      class="product-flow-card product-flow-route product-flow-route--promoted">
      <span class="product-flow-route-title">
        <span>Stable Route →</span>
        <span>Approved Capsule v4.3</span>
      </span>
    </article>

    <span class="product-flow-rollback-label">
      <LucideIcon
        icon="RotateCcw"
        class="product-flow-rollback-icon"
        aria-hidden="true"
      />
      <span>Roll back to v4.2 if needed</span>
    </span>
  </div>
</div>

<style>
  .product-flow-diagram {
    width: 100%;
    max-width: 75rem;
    margin-inline: auto;
    container-type: inline-size;
  }

  .product-flow-stage {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    padding: 1rem 0.25rem 0.5rem;
  }

  .product-flow-stage::before {
    position: absolute;
    z-index: -1;
    inset: 6% 4%;
    background:
      radial-gradient(
        circle at 42% 58%,
        color-mix(in srgb, var(--color-primary) 10%, transparent),
        transparent 42%
      ),
      radial-gradient(
        circle at 75% 30%,
        color-mix(in srgb, var(--color-secondary) 9%, transparent),
        transparent 34%
      );
    filter: blur(20px);
    content: "";
  }

  .product-flow-connections {
    display: none;
  }

  .product-flow-lane-label,
  .product-flow-action-label,
  .product-flow-rollback-label,
  .product-flow-card-kicker,
  .product-flow-route-status-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1rem;
    text-transform: uppercase;
  }

  .product-flow-lane-label {
    grid-column: 1 / -1;
    color: color-mix(in srgb, var(--color-light) 78%, transparent);
  }

  .product-flow-live-label {
    margin-top: 0.25rem;
  }

  .product-flow-safe-label {
    margin-top: 0.375rem;
    color: var(--color-primary);
  }

  .product-flow-card {
    position: relative;
    z-index: 2;
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--color-light) 24%, transparent);
    border-radius: 0.875rem;
    background:
      radial-gradient(
        circle at 72% 34%,
        color-mix(in srgb, var(--color-primary) 8%, transparent),
        transparent 58%
      ),
      color-mix(in srgb, var(--color-theme-dark) 92%, transparent);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.055),
      0 16px 32px rgb(0 0 0 / 0.18);
  }

  .product-flow-route {
    grid-column: 1 / -1;
    min-height: 7rem;
    border-color: color-mix(in srgb, var(--color-secondary) 74%, transparent);
    background:
      radial-gradient(
        circle at 20% 55%,
        color-mix(in srgb, var(--color-secondary) 13%, transparent),
        transparent 60%
      ),
      color-mix(in srgb, var(--color-theme-dark) 92%, transparent);
  }

  .product-flow-route--source {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem;
  }

  .product-flow-route--promoted {
    display: grid;
    place-items: center;
    padding: 1rem;
    text-align: center;
  }

  .product-flow-route-status {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    color: var(--color-secondary);
  }

  .product-flow-route-shield {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.875rem;
    height: 2.875rem;
    color: var(--color-secondary);
  }

  .product-flow-route-shield :global(.product-flow-route-shield-icon) {
    width: 100%;
    height: 100%;
    stroke-width: 1.75;
  }

  .product-flow-route-shield :global(.product-flow-route-lock-icon) {
    position: absolute;
    width: 1rem;
    height: 1rem;
    stroke-width: 2.25;
  }

  .product-flow-route-status-label {
    color: var(--color-secondary);
    letter-spacing: 0.05em;
  }

  .product-flow-route-title {
    display: grid;
    min-width: 0;
    gap: 0.125rem;
    color: var(--color-light);
    font-family: var(--font-secondary);
    font-size: clamp(1.125rem, 4.4cqw, 1.75rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.18;
  }

  .product-flow-mobile-fork-connector,
  .product-flow-mobile-promote-connector {
    position: relative;
    z-index: 1;
    display: flex;
    grid-column: 1 / -1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.125rem;
    min-height: 2.75rem;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1rem;
    text-transform: uppercase;
  }

  .product-flow-mobile-fork-connector::before,
  .product-flow-mobile-promote-connector::before {
    width: 1px;
    height: 1rem;
    background: color-mix(in srgb, currentColor 74%, transparent);
    content: "";
  }

  .product-flow-mobile-promote-connector {
    color: var(--color-secondary);
  }

  .product-flow-mobile-connector-icon {
    width: 1rem;
    height: 1rem;
    margin-top: -0.25rem;
    stroke-width: 2;
  }

  .product-flow-action-label {
    display: none;
  }

  .product-flow-fork {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.875rem;
    min-height: 7.5rem;
    border-color: color-mix(in srgb, var(--color-primary) 78%, transparent);
    padding: 0.875rem;
  }

  .product-flow-fork-actors {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: 4.5rem;
    height: 3.375rem;
  }

  .product-flow-fork-actor {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid color-mix(in srgb, var(--color-light) 34%, transparent);
    border-radius: 9999px;
    color: var(--color-light);
    background: color-mix(in srgb, var(--color-theme-dark) 94%, transparent);
  }

  .product-flow-fork-actor :global(.product-flow-fork-user-icon) {
    width: 1.7rem;
    height: 1.7rem;
    stroke-width: 1.8;
  }

  .product-flow-fork-actor--agent {
    z-index: 2;
    width: 2.875rem;
    height: 2.875rem;
    margin-bottom: -0.125rem;
    margin-left: -1.125rem;
    border-color: color-mix(in srgb, var(--color-primary) 72%, transparent);
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 9%, var(--color-body));
  }

  .product-flow-fork-actor :global(.product-flow-fork-bot-icon) {
    width: 1.75rem;
    height: 1.75rem;
    stroke-width: 1.8;
  }

  .product-flow-card-copy {
    display: grid;
    min-width: 0;
    gap: 0.25rem;
  }

  .product-flow-card-kicker {
    color: var(--color-primary);
  }

  .product-flow-card-title,
  .product-flow-step-title {
    color: var(--color-light);
    font-family: var(--font-secondary);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }

  .product-flow-card-detail,
  .product-flow-step-detail {
    color: var(--color-primary);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.125rem;
  }

  .product-flow-step {
    display: grid;
    min-width: 0;
    min-height: 7.25rem;
    align-content: center;
    justify-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.375rem;
    text-align: center;
  }

  .product-flow-step:not(.product-flow-test)::before {
    position: absolute;
    top: 50%;
    left: -0.75rem;
    width: 0.75rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-primary) 72%, transparent);
    content: "";
  }

  .product-flow-step:not(.product-flow-test)::after {
    position: absolute;
    top: calc(50% - 0.1875rem);
    left: -0.3125rem;
    width: 0.375rem;
    height: 0.375rem;
    border-top: 1px solid var(--color-primary);
    border-right: 1px solid var(--color-primary);
    transform: rotate(45deg);
    content: "";
  }

  .product-flow-step-icon,
  .product-flow-approval-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-light);
  }

  .product-flow-step-icon :global(.product-flow-icon) {
    width: 100%;
    height: 100%;
    stroke-width: 1.75;
  }

  .product-flow-step-title {
    font-size: clamp(0.8125rem, 3.1cqw, 1.125rem);
  }

  .product-flow-step-detail {
    margin-top: -0.125rem;
    color: var(--color-primary);
    font-size: clamp(0.625rem, 2.3cqw, 0.75rem);
  }

  .product-flow-approval-icon {
    position: relative;
  }

  .product-flow-approval-icon > :global(.product-flow-icon) {
    width: 2.125rem;
    height: 2.125rem;
    stroke-width: 1.75;
  }

  .product-flow-approval-check {
    position: absolute;
    right: -0.25rem;
    bottom: -0.125rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-light) 52%, transparent);
    border-radius: 9999px;
    color: var(--color-light);
    background: var(--color-primary);
  }

  .product-flow-approval-check :global(.product-flow-approval-check-icon) {
    width: 0.8125rem;
    height: 0.8125rem;
    stroke-width: 3;
  }

  .product-flow-rollback-label {
    display: inline-flex;
    grid-column: 1 / -1;
    align-items: center;
    justify-self: center;
    gap: 0.375rem;
    margin-top: 0.125rem;
    color: color-mix(in srgb, var(--color-text-default) 92%, transparent);
    font-size: 0.6875rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .product-flow-rollback-label :global(.product-flow-rollback-icon) {
    width: 0.875rem;
    height: 0.875rem;
    color: color-mix(in srgb, var(--color-text-default) 82%, transparent);
    stroke-width: 1.8;
  }

  @container (min-width: 48rem) {
    .product-flow-stage {
      display: block;
      height: clamp(25rem, 46.667cqw, 35rem);
      padding: 0;
    }

    .product-flow-connections {
      position: absolute;
      z-index: 0;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
      fill: none;
      pointer-events: none;
    }

    .product-flow-connection {
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .product-flow-connection-primary {
      stroke: color-mix(in srgb, var(--color-primary) 92%, transparent);
      stroke-width: 2px;
    }

    .product-flow-connection-secondary {
      stroke: color-mix(in srgb, var(--color-secondary) 92%, transparent);
      stroke-width: 2px;
    }

    .product-flow-connection-rollback {
      stroke: color-mix(in srgb, var(--color-text-default) 78%, transparent);
      stroke-dasharray: 7 8;
      stroke-width: 1.75px;
    }

    .product-flow-marker-primary {
      fill: var(--color-primary);
    }

    .product-flow-marker-secondary {
      fill: var(--color-secondary);
    }

    .product-flow-marker-neutral {
      fill: color-mix(in srgb, var(--color-text-default) 84%, transparent);
    }

    .product-flow-lane-label,
    .product-flow-action-label,
    .product-flow-rollback-label {
      position: absolute;
      z-index: 3;
      display: block;
    }

    .product-flow-lane-label {
      color: var(--color-light);
      font-family: var(--font-secondary);
      font-size: clamp(1.25rem, 2.55cqw, 2rem);
      font-weight: 500;
      letter-spacing: 0.01em;
      line-height: 1.1;
      text-transform: none;
    }

    .product-flow-live-label {
      top: 17%;
      left: 1%;
      margin: 0;
    }

    .product-flow-safe-label {
      top: 70%;
      left: 1%;
      margin: 0;
      color: var(--color-light);
    }

    .product-flow-mobile-fork-connector,
    .product-flow-mobile-promote-connector {
      display: none;
    }

    .product-flow-action-label {
      font-size: clamp(0.75rem, 1.65cqw, 1.25rem);
      text-transform: none;
    }

    .product-flow-fork-label {
      top: 31%;
      left: 28%;
      color: var(--color-primary);
    }

    .product-flow-promote-label {
      top: 57.5%;
      left: 88%;
      color: var(--color-secondary);
    }

    .product-flow-card {
      position: absolute;
      margin: 0;
    }

    .product-flow-route--source {
      top: 7.1429%;
      left: 23.3333%;
      width: 33.3333%;
      height: 20.7143%;
      min-height: 0;
      grid-template-columns: clamp(4rem, 7cqw, 5.5rem) minmax(0, 1fr);
      gap: clamp(0.625rem, 1.25cqw, 1rem);
      padding: clamp(0.625rem, 1.2cqw, 1rem);
    }

    .product-flow-route--promoted {
      top: 33.9286%;
      left: 70.8333%;
      width: 27.5%;
      height: 19.6429%;
      min-height: 0;
      padding: clamp(0.75rem, 1.3cqw, 1.125rem);
    }

    .product-flow-route-shield {
      width: clamp(2.5rem, 4.25cqw, 3.5rem);
      height: clamp(2.5rem, 4.25cqw, 3.5rem);
    }

    .product-flow-route-status-label {
      font-size: clamp(0.625rem, 1.2cqw, 0.8125rem);
    }

    .product-flow-route-title {
      font-size: clamp(1.125rem, 2.55cqw, 1.8rem);
    }

    .product-flow-route--promoted .product-flow-route-title {
      font-size: clamp(1rem, 2.25cqw, 1.65rem);
    }

    .product-flow-fork {
      top: 62.5%;
      left: 20.8333%;
      width: 22.5%;
      height: 24.1071%;
      min-height: 0;
      grid-template-columns: clamp(3.25rem, 5.6cqw, 4.5rem) minmax(0, 1fr);
      gap: clamp(0.5rem, 1cqw, 0.875rem);
      padding: clamp(0.625rem, 1.15cqw, 1rem);
    }

    .product-flow-fork-actors {
      width: clamp(3.25rem, 5.6cqw, 4.5rem);
      height: clamp(2.75rem, 4.75cqw, 3.5rem);
    }

    .product-flow-fork-actor {
      width: clamp(2.125rem, 3.7cqw, 2.875rem);
      height: clamp(2.125rem, 3.7cqw, 2.875rem);
    }

    .product-flow-fork-actor--agent {
      width: clamp(2.25rem, 3.9cqw, 3rem);
      height: clamp(2.25rem, 3.9cqw, 3rem);
      margin-left: clamp(-1.125rem, -1.6cqw, -0.875rem);
    }

    .product-flow-card-kicker {
      font-size: clamp(0.5625rem, 1cqw, 0.6875rem);
      line-height: 1;
    }

    .product-flow-card-title {
      font-size: clamp(0.875rem, 1.65cqw, 1.25rem);
    }

    .product-flow-card-detail {
      font-size: clamp(0.625rem, 1.1cqw, 0.8125rem);
      line-height: 1.2;
    }

    .product-flow-step {
      top: 64.2857%;
      min-height: 0;
      height: 22.3214%;
      padding: clamp(0.5rem, 1cqw, 0.875rem);
    }

    .product-flow-test {
      left: 48.3333%;
      width: 11.25%;
    }

    .product-flow-diff {
      left: 64.1667%;
      width: 12.9167%;
    }

    .product-flow-approval {
      left: 81.6667%;
      width: 13.75%;
    }

    .product-flow-step::before,
    .product-flow-step::after {
      content: none;
    }

