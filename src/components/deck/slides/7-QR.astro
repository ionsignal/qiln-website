---
import qrCode from "@/assets/images/qr.png";
import DeckSlideFooter from "@/components/deck/SlideFooter.astro";
import Image from "@/components/helpers/Image.astro";
import type { DeckContent } from "@/types/deck";

interface Props {
  content: DeckContent["slides"]["qr"];
}

const { content } = Astro.props;
---

<section
  class="slide-qr px-4 py-8 md:px-8 md:py-10 lg:px-12 lg:py-8"
  aria-labelledby="qr-slide-heading">
  <div class="qr-layout mx-auto max-w-5xl">
    <header class="qr-copy">
      <p class="text-primary text-sm font-medium tracking-[0.16em] uppercase md:text-base">
        {content.eyebrow}
      </p>
      <h2 id="qr-slide-heading" class="mt-3 text-3xl/tight md:text-5xl/tight">
        {content.title}
      </h2>
      <p class="text-text-default mt-4 max-w-xl text-base leading-relaxed md:text-lg">
        {content.subtitle}
      </p>
      <section
        class="qr-social-links"
        aria-labelledby="qr-social-links-heading">
        <h3 id="qr-social-links-heading" class="qr-social-links-heading">
          Connect with Qiln
        </h3>
        <ul class="qr-social-links-list">
          {content.socialLinks.map((socialUrl) => (
            <li>
              <a href={socialUrl} target="_blank" rel="noopener noreferrer">
                {socialUrl}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </header>
    <div class="qr-visual">
      <div class="qr-code-backplate" aria-hidden="true"></div>
      <div class="qr-code-card">
        <Image
          src={qrCode}
          alt="Qiln QR code"
          class="qr-code-image"
          width={320}
          height={320}
        />
        <p class="qr-code-instruction">Scan to visit Qiln</p>
      </div>
    </div>
  </div>
  <DeckSlideFooter />
</section>

<style>
  .slide-qr {
    display: grid;
    min-height: 42rem;
    grid-template-rows: minmax(0, 1fr) auto;
    background:
      radial-gradient(
        circle at 72% 48%,
        color-mix(in srgb, var(--color-primary) 17%, transparent),
        transparent 42%
      ),
      radial-gradient(
        circle at 28% 78%,
        color-mix(in srgb, var(--color-secondary) 8%, transparent),
        transparent 40%
      ),
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--color-theme-dark) 58%, transparent),
        transparent
      );
  }

  .qr-layout {
    display: grid;
    width: 100%;
    gap: 2rem;
    align-self: center;
    align-items: center;
  }

  .qr-copy,
  .qr-visual {
    min-width: 0;
  }

  .qr-social-links {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .qr-social-links-heading {
    margin: 0;
    color: var(--color-light);
    font-family: var(--font-secondary);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.25rem;
  }

  .qr-social-links-list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .qr-social-links-list a {
    display: block;
    width: fit-content;
    max-width: 100%;
    overflow-wrap: anywhere;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-primary) 44%, transparent);
    padding-bottom: 0.125rem;
    color: var(--color-secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.25rem;
    text-decoration: none;
    transition:
      border-color 200ms ease,
      color 200ms ease;
  }

  .qr-social-links-list a:hover {
    border-color: var(--color-secondary);
    color: var(--color-light);
  }

  .qr-social-links-list a:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid var(--color-primary);
    outline-offset: 0.25rem;
  }

  .qr-visual {
    position: relative;
    display: grid;
    min-height: 18rem;
    place-items: center;
  }

  .qr-code-backplate {
    position: absolute;
    width: min(76%, 19rem);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--color-primary) 24%, transparent);
    border-radius: 1.25rem;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-primary) 10%, transparent),
        color-mix(in srgb, var(--color-secondary) 5%, transparent)
      ),
      color-mix(in srgb, var(--color-theme-dark) 72%, transparent);
    transform: rotate(5deg);
  }

  .qr-code-card {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(100%, 20rem);
    gap: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 52%, transparent);
    border-radius: 1rem;
    background:
      radial-gradient(
        circle at 80% 12%,
        color-mix(in srgb, var(--color-primary) 10%, transparent),
        transparent 42%
      ),
      color-mix(in srgb, var(--color-theme-dark) 96%, transparent);
    padding: 1.25rem;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 24px 54px rgb(0 0 0 / 0.26),
      0 0 36px color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  .qr-code-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    background: var(--color-light);
    padding: 0.5rem;
  }

  .qr-code-instruction {
    margin: 0;
    color: var(--color-light);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1rem;
    text-align: center;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .qr-layout {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr);
      gap: 3rem;
    }

    .qr-visual {
      min-height: 22rem;
    }

    .qr-social-links-list a {
      font-size: 0.8125rem;
    }
  }

  @media (min-width: 1024px) {
    .qr-layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.95fr);
      gap: 4rem;
    }
  }
</style>
