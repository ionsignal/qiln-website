---
import LucideIcon from "@/components/helpers/LucideIcon.astro";

const capsuleGroups = [
  { label: "Workflow logic + services", icon: "Workflow" },
  {
    label: "Dependencies, models, assets + files",
    icon: "Package",
  },
  {
    label: "Routes, schemas + credential references",
    icon: "Route",
  },
  {
    label: "Tests, snapshots + release evidence",
    icon: "ClipboardCheck",
  },
] as const;
---

<div class="solution-stage mx-auto w-full max-w-5xl">
  <article class="solution-capsule">
    <div class="flex items-start justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="solution-icon-wrap">
          <LucideIcon icon="Workflow" class="h-5 w-5" aria-hidden="true" />
        </span>
        <h3 class="text-lg font-medium text-white">Known-Good Capsule</h3>
      </div>
      <span class="solution-version">Version v42</span>
    </div>
    <ul class="solution-group-list mt-6">
      {
        capsuleGroups.map((group) => (
          <li class="solution-group">
            <LucideIcon
              icon={group.icon}
              class="text-primary h-5 w-5 shrink-0"
              aria-hidden="true"
            />
            <span>{group.label}</span>
          </li>
        ))
      }
    </ul>
  </article>
  <aside class="solution-route" aria-label="Production route alias">
    <span class="solution-route-connector" aria-hidden="true"></span>
    <div class="solution-route-card">
      <div class="flex items-center gap-3">
        <span class="solution-icon-wrap">
          <LucideIcon icon="LockKeyhole" class="h-5 w-5" aria-hidden="true" />
        </span>
        <span class="text-sm font-medium text-white">
          Production route alias
        </span>
      </div>
      <code class="solution-route-mapping">/generate → v42</code>
      <span class="solution-route-status">
        <LucideIcon icon="ShieldCheck" class="h-4 w-4" aria-hidden="true" />
        Live known-good version
      </span>
    </div>
  </aside>
</div>

<style>
  .solution-stage {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .solution-capsule,
  .solution-route-card {
    border: 1px solid color-mix(in srgb, var(--color-light) 24%, transparent);
    background: color-mix(in srgb, var(--color-theme-dark) 76%, transparent);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.035),
      0 18px 42px rgb(0 0 0 / 0.16);
  }

  .solution-capsule {
    border-color: color-mix(in srgb, var(--color-primary) 46%, transparent);
    border-radius: 1rem;
    padding: 1.5rem;
  }

  .solution-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 40%, transparent);
    border-radius: 0.5rem;
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }

  .solution-version {
    flex: none;
    border: 1px solid
      color-mix(in srgb, var(--color-secondary) 38%, transparent);
    border-radius: 9999px;
    padding: 0.25rem 0.625rem;
    color: var(--color-secondary);
    background: color-mix(in srgb, var(--color-secondary) 7%, transparent);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .solution-group-list {
    display: grid;
    gap: 0.625rem;
    padding: 0;
    list-style: none;
  }

  .solution-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-light) 16%, transparent);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--color-body) 42%, transparent);
    padding: 0.875rem;
    color: var(--color-light);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25rem;
  }

  .solution-route {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
  }

  .solution-route-connector {
    width: 1px;
    height: 2rem;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-primary) 15%, transparent),
      color-mix(in srgb, var(--color-primary) 72%, transparent)
    );
  }

  .solution-route-card {
    width: min(100%, 20rem);
    border-radius: 0.875rem;
    padding: 1rem;
  }

  .solution-route-mapping {
    display: block;
    margin-top: 1rem;
    color: var(--color-light);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
  }

  .solution-route-status {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.625rem;
    color: var(--color-secondary);
    font-size: 0.75rem;
    font-weight: 500;
  }

  @media (min-width: 1024px) {
    .solution-stage {
      grid-template-columns: minmax(0, 1fr) 16rem;
      gap: 0;
    }

    .solution-route {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      align-items: center;
      justify-items: stretch;
    }

    .solution-route-connector {
      width: 100%;
      height: 1px;
      background: linear-gradient(
        to right,
        color-mix(in srgb, var(--color-primary) 72%, transparent),
        color-mix(in srgb, var(--color-primary) 15%, transparent)
      );
    }
  }
</style>
