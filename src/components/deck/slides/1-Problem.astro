---
import LucideIcon from "@/components/helpers/LucideIcon.astro";

const changeItems = [
  "Model swap",
  "New inputs or outputs",
  "Runtime dependencies",
  "CUDA drivers",
] as const;

const productionQuestions = ["Reproduce?", "Inspect?", "Roll back?"] as const;

const workflowArtifacts = [
  { label: "Workflow logic + services", icon: "Workflow" },
  { label: "Models + private assets", icon: "Database" },
  { label: "Inputs, outputs + persistent files", icon: "Folder" },
  { label: "Configuration + dependencies", icon: "Settings2" },
  { label: "Routes + schemas", icon: "Route" },
  { label: "Credential references", icon: "KeyRound" },
  { label: "Test / release evidence", icon: "ClipboardCheck" },
  {
    label: "External actions / side-effect policy",
    icon: "ShieldAlert",
  },
] as const;
---

<div class="problem-flow mx-auto w-full max-w-7xl">
  <section class="problem-change-card" aria-labelledby="problem-change-heading">
    <div class="flex items-center gap-3">
      <span class="problem-icon-wrap">
        <LucideIcon icon="PencilLine" class="h-5 w-5" aria-hidden="true" />
      </span>
      <h3 id="problem-change-heading" class="text-base font-medium text-white">
        Change requested
      </h3>
    </div>
    <ul class="mt-4 space-y-2">
      {changeItems.map((item) => <li class="problem-change-item">{item}</li>)}
    </ul>
  </section>
  <div class="problem-transition">
    <div class="problem-unsafe-path" aria-hidden="true"></div>
    <ul class="problem-question-list" aria-label="Questions before production">
      {
        productionQuestions.map((question) => (
          <li class="problem-question">{question}</li>
        ))
      }
    </ul>
    <p class="problem-warning" role="note">
      <span>No captured known-good state.</span>
    </p>
  </div>
  <section class="problem-workflow" aria-labelledby="problem-workflow-heading">
    <div class="flex items-center gap-3">
      <span class="problem-icon-wrap">
        <LucideIcon icon="Workflow" class="h-5 w-5" aria-hidden="true" />
      </span>
      <h3 id="problem-workflow-heading" class="text-lg font-medium text-white">
        Messy Production State
      </h3>
    </div>
    <ul class="problem-artifact-grid mt-5">
      {
        workflowArtifacts.map((artifact) => (
          <li class="problem-artifact">
            <LucideIcon
              icon={artifact.icon}
              class="text-primary h-4 w-4 shrink-0"
              aria-hidden="true"
            />
            <span>{artifact.label}</span>
          </li>
        ))
      }
    </ul>
  </section>
</div>

<style>
  .problem-flow {
    display: grid;
    min-width: 0;
    gap: 1.25rem;
  }

  .problem-change-card,
  .problem-transition,
  .problem-workflow {
    min-width: 0;
  }

  .problem-change-card,
  .problem-workflow,
  .problem-question {
    border: 1px solid color-mix(in srgb, var(--color-light) 20%, transparent);
    background: color-mix(in srgb, var(--color-theme-dark) 72%, transparent);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.035);
  }

  .problem-change-card {
    align-self: center;
    border-radius: 0.875rem;
    padding: 1.25rem;
  }

  .problem-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 38%, transparent);
    border-radius: 0.5rem;
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 7%, transparent);
  }

  .problem-change-item {
    overflow-wrap: anywhere;
    border-radius: 0.375rem;
    background: color-mix(in srgb, var(--color-body) 46%, transparent);
    padding: 0.5rem 0.625rem;
    color: var(--color-text-default);
    font-size: 0.8125rem;
    line-height: 1.25rem;
  }

  .problem-transition {
    display: grid;
    gap: 0.875rem;
    align-content: center;
  }

  .problem-unsafe-path {
    width: 1px;
    height: 2.25rem;
    margin: 0 auto;
    background: linear-gradient(
      to bottom,
      transparent,
      rgb(248 113 113 / 0.8),
      transparent
    );
  }

  .problem-question-list {
    display: grid;
    min-width: 0;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .problem-question {
    display: flex;
    min-width: 0;
    min-height: 4rem;
    align-items: center;
    justify-content: center;
    overflow-wrap: anywhere;
    border-radius: 0.625rem;
    padding: 0.75rem 0.5rem;
    color: var(--color-light);
    font-size: 0.875rem;
    font-weight: 500;
    text-align: center;
  }

  .problem-warning {
    display: flex;
    min-width: 0;
    align-items: flex-start;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    color: rgb(252 165 165);
    font-size: 0.85rem;
    line-height: 1.125rem;
    text-align: center;
  }

  .problem-warning span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .problem-warning :global(svg) {
    margin-top: 0.0625rem;
  }

  .problem-workflow {
    container-type: inline-size;
    border-radius: 1rem;
    padding: 1.25rem;
  }

  .problem-artifact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.625rem;
    padding: 0;
    list-style: none;
  }

  .problem-artifact {
    display: flex;
    min-width: 0;
    align-items: flex-start;
    gap: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--color-light) 15%, transparent);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--color-body) 40%, transparent);
    padding: 0.625rem;
    color: var(--color-text-default);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.125rem;
  }

  .problem-artifact span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  @container (min-width: 32rem) {
    .problem-artifact-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .problem-flow {
      grid-template-columns: minmax(0, 1.05fr) minmax(8.5rem, 0.6fr) minmax(
          0,
          2.35fr
        );
      gap: 1rem;
      align-items: center;
    }

    .problem-unsafe-path {
      width: 100%;
      height: 1px;
      background: linear-gradient(
        to right,
        transparent,
        rgb(248 113 113 / 0.8),
        transparent
      );
    }

    .problem-question-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .problem-question {
      min-height: 3.5rem;
      font-size: 1rem;
    }
  }
</style>
