---
import DeckIcon from "@/components/deck/DeckIcon.astro";
import LucideIcon from "@/components/helpers/LucideIcon.astro";

const pilotPartners = ["Mowie", "GitHits"] as const;

const activationMilestones = [
  {
    label: "Customer discovery",
    status: "complete",
  },
  {
    label: "Pilot commitment",
    status: "complete",
  },
  {
    label: "Product-ready deployment",
    status: "pending",
  },
  {
    label: "Paid-pilot activation",
    status: "pending",
  },
] as const;

const commitmentCount = pilotPartners.length;
---

<div class="evidence-stage mx-auto w-full max-w-4xl">
  <div class="evidence-commitment-row">
    <article
      class="evidence-metric"
      aria-labelledby="evidence-commitment-heading">
      <div class="evidence-metric-heading">
        <strong class="evidence-metric-count">{commitmentCount}</strong>
        <div class="evidence-metric-copy">
          <p class="evidence-metric-kicker">Conditional</p>
          <h3 id="evidence-commitment-heading" class="evidence-metric-label">
            paid-pilot commitments
          </h3>
        </div>
      </div>
      <div class="evidence-metric-divider" aria-hidden="true"></div>
      <div class="evidence-metric-detail">
        <span class="evidence-metric-icon">
          <LucideIcon
            icon="ClipboardCheck"
            class="h-7 w-7"
            aria-hidden="true"
          />
        </span>
        <p>Pilots begin after product-ready deployment</p>
      </div>
    </article>
    <div class="evidence-commitment-connectors" aria-hidden="true">
      <svg
        class="evidence-commitment-lines"
        viewBox="0 0 100 200"
        preserveAspectRatio="none"
        focusable="false">
        <path
          class="evidence-commitment-connector-mobile"
          d="M50 0 V200"
          vector-effect="non-scaling-stroke">
        </path>
        <path
          class="evidence-commitment-connector-desktop"
          d="M0 100 H50"
          vector-effect="non-scaling-stroke">
        </path>
        <path
          class="evidence-commitment-connector-desktop"
          d="M50 50 V150"
          vector-effect="non-scaling-stroke">
        </path>
        <path
          class="evidence-commitment-connector-desktop"
          d="M50 50 H100"
          vector-effect="non-scaling-stroke">
        </path>
        <path
          class="evidence-commitment-connector-desktop"
          d="M50 150 H100"
          vector-effect="non-scaling-stroke">
        </path>
      </svg>
      <span class="evidence-commitment-node evidence-commitment-node-mobile">
      </span>
      <span
        class="evidence-commitment-node evidence-commitment-node-desktop evidence-commitment-node-center">
      </span>
      <span
        class="evidence-commitment-node evidence-commitment-node-desktop evidence-commitment-node-top">
      </span>
      <span
        class="evidence-commitment-node evidence-commitment-node-desktop evidence-commitment-node-bottom">
      </span>
    </div>
    <div class="evidence-partners">
      <ul
        class="evidence-partner-list"
        aria-label="Conditional paid-pilot partners">
        {
          pilotPartners.map((partnerName) => (
            <li>
              <article class="evidence-partner-card">
                <DeckIcon icon="UsersRound" class="evidence-partner-icon" />
                <div class="evidence-partner-copy">
                  <h3 class="evidence-partner-name">{partnerName}</h3>
                  <p class="evidence-partner-status">
                    <span>Conditional</span>
                    <span>paid pilot</span>
                  </p>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <ol class="evidence-timeline" aria-label="Paid-pilot activation path">
    {
      activationMilestones.map((milestone, index) => {
        const nextMilestone = activationMilestones[index + 1];
        const connectorIsComplete =
          milestone.status === "complete" &&
          nextMilestone?.status === "complete";
        return (
          <li class:list={["evidence-timeline-item", `is-${milestone.status}`]}>
            <span class="evidence-timeline-marker">
              {milestone.status === "complete" && (
                <LucideIcon icon="Check" class="h-5 w-5" aria-hidden="true" />
              )}
            </span>
            <span class="evidence-timeline-label">{milestone.label}</span>
            {nextMilestone && (
              <span
                class:list={[
                  "evidence-timeline-connector",
                  connectorIsComplete ? "is-complete" : "is-pending",
                ]}
                aria-hidden="true">
                <span class="evidence-timeline-connector-line" />
                <svg
                  class="evidence-timeline-connector-arrow"
                  viewBox="0 0 10 10"
                  focusable="false">
                  <path d="M1 2 L5 6 L9 2" />
                </svg>
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</div>

<style>
  .evidence-stage {
    display: grid;
    container-type: inline-size;
    gap: 1.25rem;
  }

  .evidence-commitment-row {
    display: grid;
    min-width: 0;
  }

  .evidence-metric,
  .evidence-partner-card {
    background:
      radial-gradient(
        circle at 76% 24%,
        color-mix(in srgb, var(--color-primary) 11%, transparent),
        transparent 48%
      ),
      color-mix(in srgb, var(--color-theme-dark) 94%, transparent);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 18px 42px rgb(0 0 0 / 0.18);
  }

  .evidence-metric {
    position: relative;
    z-index: 2;
    display: grid;
    min-width: 0;
    align-content: center;
    gap: 1rem;
    border: 1.5px solid
      color-mix(in srgb, var(--color-primary) 42%, transparent);
    border-radius: 1rem;
    padding: clamp(1rem, 4cqw, 1.5rem);
  }

  .evidence-metric-heading {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: clamp(0.75rem, 3cqw, 1.25rem);
  }

  .evidence-metric-count {
    flex: none;
    color: var(--color-light);
    font-family: var(--font-secondary);
    font-size: clamp(4.25rem, 19cqw, 6rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.75;
  }

  .evidence-metric-copy {
    display: grid;
    min-width: 0;
    gap: 0.25rem;
  }

  .evidence-metric-kicker {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: clamp(0.625rem, 2.5cqw, 0.75rem);
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1rem;
    text-transform: uppercase;
  }

  .evidence-metric-label {
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--color-light);
    font-family: var(--font-secondary);
    font-size: clamp(1.25rem, 6cqw, 1.875rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.08;
  }

  .evidence-metric-divider {
    width: 100%;
    height: 2px;
    background: linear-gradient(
      to right,
      var(--color-primary),
      color-mix(in srgb, var(--color-primary) 16%, transparent)
    );
  }

  .evidence-metric-detail {
    display: grid;
    min-width: 0;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
  }

  .evidence-metric-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
  }

  .evidence-metric-icon {
    width: 3rem;
    height: 3rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 44%, transparent);
    border-radius: 0.625rem;
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }

  .evidence-metric-detail p {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--color-light);
    font-size: clamp(0.9375rem, 3.5cqw, 1.1875rem);
    font-weight: 500;
    line-height: 1.3;
  }

  .evidence-metric-icon :global(svg) {
    stroke-width: 1.5;
  }

  .evidence-commitment-connectors {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 2.75rem;
    pointer-events: none;
  }

  .evidence-commitment-lines {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }

  .evidence-commitment-connector-mobile,
  .evidence-commitment-connector-desktop {
    fill: none;
    stroke: color-mix(in srgb, var(--color-primary) 58%, transparent);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.25px;
  }

  .evidence-commitment-connector-desktop {
    display: none;
  }

  .evidence-commitment-node {
    position: absolute;
    z-index: 1;
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--color-theme-dark);
    border-radius: 9999px;
    background: var(--color-primary);
  }

  .evidence-commitment-node-mobile {
    bottom: 0;
    left: 50%;
    transform: translate(-50%, 50%);
  }

  .evidence-commitment-node-desktop {
    display: none;
  }

  .evidence-partners {
    position: relative;
    z-index: 2;
    min-width: 0;
  }

  .evidence-partner-list {
    display: grid;
    min-width: 0;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evidence-partner-list > li {
    display: grid;
    min-width: 0;
  }

  .evidence-partner-card {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 6.25rem;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.875rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 54%, transparent);
    border-radius: 0.875rem;
    padding: 0.875rem 1rem;
  }

  .evidence-partner-icon :global(.deck-icon-wrap) {
    width: 3.25rem;
    height: 3.25rem;
    border-color: color-mix(in srgb, var(--color-primary) 42%, transparent);
    border-radius: 0.625rem;
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }

  .evidence-partner-icon :global(.deck-icon-glyph) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .evidence-partner-copy {
    display: grid;
    min-width: 0;
    gap: 0.5rem;
  }

  .evidence-partner-name {
    margin: 0;
    color: var(--color-light);
    font-family: var(--font-secondary);
    font-size: clamp(1.375rem, 5.5cqw, 2rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .evidence-partner-status {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    color: var(--color-light);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.125rem;
  }

  .evidence-partner-status span:first-child {
    border: 1px solid color-mix(in srgb, var(--color-primary) 72%, transparent);
    border-radius: 0.5rem;
    padding: 0.2rem 0.45rem;
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .evidence-timeline {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-light) 16%, transparent);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--color-theme-dark) 72%, transparent);
    list-style: none;
  }

  .evidence-timeline-item {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 3rem;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
  }

  .evidence-timeline-marker {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 2px solid currentColor;
    border-radius: 9999px;
    background: var(--color-theme-dark);
  }

  .evidence-timeline-item.is-complete {
    color: var(--color-primary);
  }

  .evidence-timeline-item.is-pending {
    color: color-mix(in srgb, var(--color-text-default) 62%, transparent);
  }

  .evidence-timeline-item.is-complete .evidence-timeline-marker {
    background: color-mix(in srgb, var(--color-primary) 9%, transparent);
  }

  .evidence-timeline-label {
    min-width: 0;
    color: var(--color-light);
    font-family: var(--font-secondary);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.15;
  }

  .evidence-timeline-connector {
    position: absolute;
    z-index: 0;
    top: 2.5rem;
    left: 0;
    display: block;
    width: 2.5rem;
    height: calc(100% - 1.875rem);
    pointer-events: none;
  }

  .evidence-timeline-connector.is-complete {
    color: var(--color-primary);
  }

  .evidence-timeline-connector.is-pending {
    color: color-mix(in srgb, var(--color-text-default) 52%, transparent);
  }

  .evidence-timeline-connector-line {
    position: absolute;
    top: 0;
    bottom: 0.375rem;
    left: 50%;
    width: 0;
    border-left: 1.25px solid currentColor;
    transform: translateX(-50%);
  }

  .evidence-timeline-connector-arrow {
    position: absolute;
    bottom: 0;
    left: 50%;
    display: block;
    width: 0.625rem;
    height: 0.625rem;
    overflow: visible;
    fill: none;
    transform: translateX(-50%);
  }

  .evidence-timeline-connector-arrow path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5px;
  }

  @media (min-width: 768px) {
    .evidence-timeline {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      padding: 1rem 0.75rem 0.875rem;
    }

    .evidence-timeline-item {
      min-height: 5.5rem;
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 0.75rem;
      padding-inline: 0.375rem;
      text-align: center;
    }

    .evidence-timeline-label {
      max-width: 10rem;
      font-size: clamp(0.8125rem, 1.8cqw, 1rem);
    }

    .evidence-timeline-connector {
      top: 0.75rem;
      left: calc(50% + 1.25rem);
      width: calc(100% - 2.5rem);
      height: 1rem;
    }

    .evidence-timeline-connector-line {
      top: 50%;
      right: 0.375rem;
      bottom: auto;
      left: 0;
      width: auto;
      height: 0;
      border-top: 1.25px solid currentColor;
      border-left: 0;
      transform: translateY(-50%);
    }

    .evidence-timeline-connector-arrow {
      top: 50%;
      right: 0;
      bottom: auto;
      left: auto;
      transform: translateY(-50%) rotate(-90deg);
    }
  }

  @media (min-width: 1024px) {
    .evidence-stage {
      gap: 1.125rem;
    }

    .evidence-commitment-row {
      grid-template-columns:
        minmax(0, 1.12fr) clamp(3.5rem, 6cqw, 5rem)
        minmax(18rem, 0.88fr);
      align-items: stretch;
    }

    .evidence-metric {
      min-height: 12.75rem;
      gap: 0.875rem;
      padding: clamp(1.125rem, 2cqw, 1.5rem);
    }

    .evidence-metric-heading {
      gap: clamp(0.75rem, 1.75cqw, 1.25rem);
    }

    .evidence-metric-count {
      font-size: clamp(5rem, 8.5cqw, 6.5rem);
    }

    .evidence-metric-kicker {
      font-size: clamp(0.625rem, 0.95cqw, 0.75rem);
    }

    .evidence-metric-label {
      font-size: clamp(1.5rem, 2.65cqw, 2.25rem);
    }

    .evidence-metric-detail p {
      font-size: clamp(0.9375rem, 1.55cqw, 1.25rem);
    }

    .evidence-commitment-connectors {
      align-self: stretch;
      height: 100%;
      min-height: 12.75rem;
    }

    .evidence-commitment-connector-mobile,
    .evidence-commitment-node-mobile {
      display: none;
    }

    .evidence-commitment-connector-desktop,
    .evidence-commitment-node-desktop {
      display: block;
    }

    .evidence-commitment-node-center {
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    .evidence-commitment-node-top {
      top: 25%;
      right: 0;
      transform: translate(50%, -50%);
    }

    .evidence-commitment-node-bottom {
      right: 0;
      bottom: 25%;
      transform: translate(50%, 50%);
    }

    .evidence-partner-list {
      height: 100%;
      grid-template-rows: repeat(2, minmax(0, 1fr));
    }

    .evidence-partner-card {
      height: 100%;
      min-height: 0;
      gap: clamp(0.75rem, 1.25cqw, 1rem);
      padding: clamp(0.75rem, 1.25cqw, 1rem);
    }

    .evidence-partner-icon :global(.deck-icon-wrap) {
      width: clamp(2.75rem, 4.25cqw, 3.5rem);
      height: clamp(2.75rem, 4.25cqw, 3.5rem);
    }

    .evidence-partner-name {
      font-size: clamp(1.375rem, 2.2cqw, 1.875rem);
    }

    .evidence-partner-status {
      font-size: clamp(0.75rem, 1.15cqw, 0.875rem);
    }

    .evidence-timeline {
      min-height: 6.75rem;
      padding: 0.875rem 1.25rem 0.75rem;
    }

    .evidence-timeline-item {
      min-height: 5rem;
    }
  }
</style>
