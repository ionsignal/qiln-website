---
import config from ".astro/config.generated.json";
import defaultLogo from "@/assets/images/logo.svg";
import DeckSlideFooter from "@/components/deck/SlideFooter.astro";
import Image from "@/components/helpers/Image.astro";
import { formatUrl } from "@/utils/core";
import type { DeckSlideContent } from "@/types/deck";

interface Props {
  content: DeckSlideContent;
  headingId: string;
}

const { content, headingId } = Astro.props;
const diagramLabelId = `${headingId}-diagram-label`;
const diagramDescriptionId = `${headingId}-diagram-description`;
---

<section
  class="deck-slide-theme px-4 py-8 md:px-8 md:py-10 lg:px-12 lg:py-8"
  aria-labelledby={headingId}>
  <a
    class="deck-slide-brand"
    href={formatUrl("/")}
    aria-label={`${config.site.title} home`}>
    <Image
      src={defaultLogo}
      alt=""
      aria-hidden="true"
      class="block h-6 w-6"
      width={20}
      height={20}
    />
    <span>{config.site.title}</span>
  </a>
  <header class="deck-slide-header mx-auto max-w-5xl text-center">
    <p
      class="text-primary text-sm font-medium tracking-[0.16em] uppercase md:text-base">
      {content.eyebrow}
    </p>
    <h2 id={headingId} class="mt-3 text-3xl/tight md:text-5xl/tight">
      {content.title}
    </h2>
    <p
      class="text-text-default mx-auto mt-4 max-w-4xl text-base leading-relaxed md:text-lg">
      {content.subtitle}
    </p>
  </header>
  <figure
    class="deck-slide-diagram"
    aria-labelledby={diagramLabelId}
    aria-describedby={diagramDescriptionId}>
    <figcaption class="sr-only">
      <span id={diagramLabelId}>{content.diagram.label}</span>
      <span id={diagramDescriptionId}>{content.diagram.description}</span>
    </figcaption>
    <slot name="diagram" />
  </figure>
  <DeckSlideFooter content={content.footer} />
</section>

<style>
  .deck-slide-theme {
    position: relative;
    display: grid;
    min-height: 42rem;
    grid-template-rows: auto minmax(0, 1fr) auto;
    background:
      radial-gradient(
        circle at 52% 58%,
        color-mix(in srgb, var(--color-primary) 11%, transparent),
        transparent 46%
      ),
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--color-theme-dark) 54%, transparent),
        transparent
      );
  }

  .deck-slide-brand {
    position: absolute;
    z-index: 10;
    top: 0.875rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.175rem;
    color: color-mix(in srgb, var(--color-light) 68%, transparent);
    font-family: var(--font-secondary);
    font-size: 1.24rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.25rem;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .deck-slide-brand img {
    opacity: 0.68;
  }

  .deck-slide-brand:hover {
    color: var(--color-light);
  }

  .deck-slide-brand:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid var(--color-primary);
    outline-offset: 0.25rem;
  }

  .deck-slide-header {
    min-width: 0;
  }

  .deck-slide-diagram {
    display: flex;
    width: 100%;
    min-width: 0;
    align-items: center;
    margin: 1.5rem 0 0;
  }

  @media (min-width: 768px) {
    .deck-slide-brand {
      top: 1.25rem;
      right: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .deck-slide-diagram {
      margin-top: 1.25rem;
    }

    .deck-slide-brand {
    }
  }
</style>
