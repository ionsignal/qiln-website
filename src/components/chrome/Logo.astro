---
import { formatUrl } from "@/utils/core";
import { markdownify, toSentenceCase } from "@/utils/text";
import Image from "@/components/helpers/Image.astro";
import config from ".astro/config.generated.json";
import defaultLogo from "@/assets/images/logo.svg";
import type { ImageMetadata } from "astro";

interface Props {
  src?: ImageMetadata | string | null;
  class?: string;
  loading?: "eager" | "lazy";
}

const { src, class: className, loading } = Astro.props as Props;
const { logo, logoText, title } = config.site;
const logoDimensions = {
  width: 24,
  height: 24,
};
const logoIconClass = "logo text-white";
const logoTextClass =
  "logo-text font-secondary text-[1.2rem] font-normal tracking-wider text-white";
const logoAriaLabel = toSentenceCase("Brand logo of " + title);
const logoSource = src ? src : logo ? logo : defaultLogo;

let rawSvgContent = "";
if (typeof logoSource === "string" && logoSource.endsWith(".svg")) {
  const svgFiles = import.meta.glob("/src/assets/images/**/*.svg", {
    query: "?raw",
    import: "default",
  });
  const relativeLogoPath = logoSource.replace(/^\/?images\//, "");
  const svgModulePath = `/src/assets/images/${relativeLogoPath}`;
  if (svgModulePath in svgFiles) {
    const rawSvg = (await svgFiles[svgModulePath]()) as string;
    rawSvgContent = rawSvg.replace(
      /^<svg/,
      `<svg class="${logoIconClass}" aria-label="${logoAriaLabel}"`,
    );
  }
}
---

<a href={formatUrl("/")} class:list={["logo-wrapper", className]}>
  {rawSvgContent ? (
    <>
      <Fragment set:html={rawSvgContent} />
      {logoText && (
        <span class={logoTextClass} set:html={markdownify(logoText)} />
      )}
    </>
  ) : logoSource ? (
    <>
      <Image
        src={logoSource}
        class={logoIconClass}
        width={logoDimensions.width}
        height={logoDimensions.height}
        alt={logoAriaLabel}
        loading={loading}
        decoding="async"
      />
      {logoText && (
        <span class={logoTextClass} set:html={markdownify(logoText)} />
      )}
    </>
  ) : logoText ? (
    logoText
  ) : (
    title
  )}
</a>
