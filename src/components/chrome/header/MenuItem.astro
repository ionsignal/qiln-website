---
import type { NavigationLink } from "@/types";
import { formatUrl } from "@/utils/core";
import LucideIcon from "@/components/helpers/LucideIcon.astro";

interface Props {
  menu: NavigationLink;
}

const { menu } = Astro.props;
const { pathname } = Astro.url;

const isUrlActive = (url?: string) =>
  url ? pathname === `${url}/` || pathname === url : false;

const isChildActive = (item: NavigationLink) =>
  item.menus?.some((child) => isUrlActive(child.url)) || false;

const isActive = isUrlActive(menu.url) || isChildActive(menu);

const getLinkAttributes = (url?: string, rel?: string, target?: string) => {
  const isExternal = url?.startsWith("http") ?? false;
  return {
    rel: isExternal ? rel || "noopener noreferrer" : rel || undefined,
    target: isExternal ? target || "_blank" : target || undefined,
    href: formatUrl(url || Astro.url.origin),
  };
};
---

{
  menu.name && (
    <>
      {menu.menus && menu.menus.length > 0 ? (
        <li class="hs-dropdown nav-item [--adaptive:none] [--strategy:static] lg:[--strategy:absolute]">
          <button
            type="button"
            aria-haspopup="menu"
            aria-expanded="false"
            class:list={[
              "nav-link w-full justify-between gap-x-1",
              { "nav-link-active": isActive },
            ]}>
            {menu.name}
            <LucideIcon
              icon="ChevronDown"
              class="hs-dropdown-open:-rotate-180 h-4 w-4 shrink-0 transition-transform duration-200"
              aria-hidden="true"
            />
          </button>
          <div
            role="menu"
            class="hs-dropdown-menu hs-dropdown-open:opacity-100 top-full z-50 hidden w-full pt-2 opacity-0 before:absolute before:-top-4 before:left-0 before:h-4 before:w-full max-lg:transition-none lg:absolute lg:w-auto lg:pt-4 lg:transition-[opacity,margin] lg:duration-150">
            <div class="bg-theme-dark mx-2 p-2 shadow-2xl lg:mx-0 lg:rounded-2xl lg:p-2.5">
              {menu.hasMegaMenu ? (
                <div class="flex flex-col gap-2 lg:min-w-lg">
                  <div class="bg-primary/5 grid grid-cols-1 gap-2 rounded-2xl p-2 sm:grid-cols-2">
                    {menu.menus.map((child) => (
                      <a
                        role="menuitem"
                        {...getLinkAttributes(
                          child.url,
                          child.rel,
                          child.target,
                        )}
                        class="group hover:bg-primary/5 flex items-start gap-3 rounded-xl p-2 transition-colors">
                        {child.icon && (
                          <div class="bg-primary/10 text-primary group-hover:bg-primary/90 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg transition-colors group-hover:text-white">
                            <LucideIcon
                              icon={child.icon}
                              class="h-5 w-5"
                              aria-hidden="true"
                            />
                          </div>
                        )}
                        <div>
                          <div class="text-sm font-medium text-white/80 transition-colors group-hover:text-white">
                            {child.name}
                          </div>
                          {child.description && (
                            <div class="mt-0.5 text-xs text-white/60">
                              {child.description}
                            </div>
                          )}
                        </div>
                      </a>
                    ))}
                  </div>
                  {menu.cta && menu.cta.enable && (
                    <div class="hidden flex-col justify-between gap-4 p-2 lg:flex lg:flex-row lg:items-center">
                      <div>
                        <div class="text-sm font-medium text-white">
                          {menu.cta.title}
                        </div>
                        <div class="mt-1 text-xs text-white/60">
                          {menu.cta.description}
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              ) : (
                <ul class="flex min-w-48 flex-col gap-2">
                  {menu.menus.map((child) => (
                    <li>
                      <a
                        role="menuitem"
                        {...getLinkAttributes(
                          child.url,
                          child.rel,
                          child.target,
                        )}
                        class="hover:bg-primary/5 flex items-center gap-3 rounded-xl p-3 text-sm text-white/80 transition-colors hover:text-white">
                        {child.icon && (
                          <LucideIcon
                            icon={child.icon}
                            class="h-4 w-4"
                            aria-hidden="true"
                          />
                        )}
                        {child.name}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </li>
      ) : (
        <li class="nav-item" role="menuitem">
          <a
            {...getLinkAttributes(menu.url, menu.rel, menu.target)}
            class:list={["nav-link", { "nav-link-active": isActive }]}>
            {menu.badge && menu.badge.enable ? (
              menu.badge.type === "dot" ? (
                <span class="relative inline-block">
                  {menu.name}
                  <sup
                    class:list={[
                      "badge badge-dot",
                      menu.badge.color && `badge-${menu.badge.color}`,
                    ]}
                  />
                </span>
              ) : (
                <>
                  {menu.name}
                  <span
                    class:list={[
                      "badge",
                      menu.badge.color && `badge-${menu.badge.color}`,
                    ]}>
                    {menu.badge.label}
                  </span>
                </>
              )
            ) : (
              menu.name
            )}
          </a>
        </li>
      )}
    </>
  )
}
