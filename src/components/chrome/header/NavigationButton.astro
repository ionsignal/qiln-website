---
import { formatUrl } from "@/utils/core";

interface NavigationButtonData {
  url?: string;
  rel?: string;
  target?: string;
}

interface Props {
  navigationButton: NavigationButtonData;
  label: string;
}

const { navigationButton, label } = Astro.props;
const isExternal = navigationButton.url?.startsWith("http") ?? false;
const rel = isExternal
  ? navigationButton.rel || "noopener noreferrer"
  : navigationButton.rel || undefined;
const target = isExternal
  ? navigationButton.target || "_blank"
  : navigationButton.target || undefined;
---

<a
  rel={rel}
  target={target}
  class="relative flex items-center"
  href={formatUrl(navigationButton.url)}>
  <span class="btn btn-primary has-text-flip-animation" data-content={label}>
    {label}
  </span>
</a>
