---
import config from ".astro/config.generated.json";
import Logo from "@/components/chrome/Logo.astro";
import NavigationButton from "@/components/chrome/header/NavigationButton.astro";
import NavMenuItem from "@/components/chrome/header/MenuItem.astro";
import NavigationToggleButton from "@/components/chrome/header/NavigationToggleButton.astro";
import SocialChips from "@/components/social/SocialChips.astro";
import { useTranslations, sortByWeight, filteredEnabled } from "@/utils/core";
import { headerSocials } from "@/utils/socials";

const t = useTranslations();
const navigationItems = sortByWeight(filteredEnabled(t("main")));
const {
  site: { logoHoverAnimation },
  settings: { stickyHeader, headerDemoButton },
} = config;
const showHeaderDemoButton =
  headerDemoButton.enable && Boolean(headerDemoButton.url.trim());
---

<header
  data-site-header
  class:list={["header group/header", { "sticky-header": stickyHeader }]}>
  <nav class="header-nav" aria-label="Primary navigation">
    <div class="header-nav-row container">
      <Logo
        class={logoHoverAnimation ? "has-hover-animation" : ""}
        loading="eager"
      />
      <div
        id="nav-menu"
        class="hs-collapse hidden grow basis-full overflow-hidden transition-[height] duration-300 max-lg:absolute max-lg:inset-x-0 max-lg:top-full max-lg:z-40 max-lg:w-full max-lg:shadow-2xl lg:block lg:w-auto lg:basis-auto lg:overflow-visible">
        <ul class="navbar has-customized-scrollbar">
          {navigationItems.map((menu, index) => (
            <NavMenuItem
              menu={menu}
              menuId={`site-navigation-item-${index + 1}`}
            />
          ))}
          {showHeaderDemoButton && (
            <li class="max-lg:px-4 max-lg:py-2 lg:hidden" role="menuitem">
              <NavigationButton
                navigationButton={headerDemoButton}
                label={t("navigation.demoLabel")}
              />
            </li>
          )}
          {headerSocials.length > 0 && (
            <li class="mt-1 border-t border-white/10 px-4 pt-3 lg:hidden">
              <SocialChips
                links={headerSocials}
                class="gap-2"
                anchorClass="text-text-default hover:text-light focus-visible:ring-primary/60 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/5 ring-1 ring-white/10 transition-colors duration-150 hover:bg-white/10 hover:ring-white/20 focus-visible:ring-2 focus-visible:outline-none"
                iconClass="h-5 w-5"
              />
            </li>
          )}
        </ul>
      </div>
      {(headerSocials.length > 0 || showHeaderDemoButton) && (
        <div class="hidden items-center gap-2 lg:ml-auto lg:flex">
          <SocialChips
            links={headerSocials}
            class="gap-1"
            anchorClass="group text-text-default hover:text-light focus-visible:ring-primary/60 inline-flex h-9 w-9 items-center justify-center rounded-full transition-colors duration-200 hover:bg-white/5 focus-visible:ring-2 focus-visible:outline-none"
            iconClass="h-[18px] w-[18px] transition-transform duration-200 group-hover:scale-110"
          />
          {headerSocials.length > 0 && showHeaderDemoButton && (
            <span
              class="mx-1 h-5 w-px self-center bg-white/10"
              aria-hidden="true"
            />
          )}
          {showHeaderDemoButton && (
            <NavigationButton
              navigationButton={headerDemoButton}
              label={t("navigation.demoLabel")}
            />
          )}
        </div>
      )}
      <NavigationToggleButton />
    </div>
  </nav>
</header>

<script>
  let headerNavigationController: AbortController | null = null;

  function initializeHeaderNavigation() {
    headerNavigationController?.abort();
    headerNavigationController = null;

    const siteHeader =
      document.querySelector<HTMLElement>("[data-site-header]");

    if (!siteHeader) return;

    const controller = new AbortController();
    headerNavigationController = controller;

    document.addEventListener(
      "click",
      (event) => {
        const eventTarget = event.target;

        if (!(eventTarget instanceof Element)) return;

        const navigationMenu =
          siteHeader.querySelector<HTMLElement>("#nav-menu");
        const navigationToggle =
          siteHeader.querySelector<HTMLButtonElement>(".nav-toggler");

        if (!navigationMenu?.classList.contains("open")) return;

        const selectedNavigationLink = eventTarget.closest(
          "a:not(.hs-dropdown-toggle)",
        );
        const clickedOutsideNavigation =
          !navigationMenu.contains(eventTarget) &&
          (!navigationToggle || !navigationToggle.contains(eventTarget));
        const selectedMenuLink =
          navigationMenu.contains(eventTarget) &&
          selectedNavigationLink !== null;

        if (clickedOutsideNavigation || selectedMenuLink) {
          navigationToggle?.click();
        }
      },
      { signal: controller.signal },
    );
  }

  function teardownHeaderNavigation() {
    headerNavigationController?.abort();
    headerNavigationController = null;
  }

  initializeHeaderNavigation();

  window.addEventListener("pagehide", teardownHeaderNavigation);
  window.addEventListener("pageshow", initializeHeaderNavigation);
</script>
