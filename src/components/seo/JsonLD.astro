---
import generateJsonLd, { serializeJsonLd } from "@/utils/jsonLd";
import type { ResolvedSeoMetadata } from "@/types/seo";

interface Props {
  metadata: ResolvedSeoMetadata;
}

const { metadata } = Astro.props;
const jsonLdData = generateJsonLd(metadata);
const serializedJsonLd = serializeJsonLd(jsonLdData);
---

<script type="application/ld+json" is:inline set:html={serializedJsonLd} />
