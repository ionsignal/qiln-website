---
import config from ".astro/config.generated.json";
import { plainify, removeWhitespace } from "@/utils/text";
import type { SeoProps } from "@/types/seo";

type Props = SeoProps;

const {
  title: pageTitle,
  metaTitle,
  description: pageDescription,
  metaDescription,
  disableTagline,
  image = config.opengraph.image,
  twitter = config.opengraph.twitter,
  twitterCard = config.opengraph.twitterCard,
  ogType = config.opengraph.ogType,
  ogLocale = config.opengraph.ogLocale,
} = Astro.props;

let title = plainify(
  metaTitle ? metaTitle : pageTitle ? pageTitle : config.site.title,
);

title = removeWhitespace(title);

const description = removeWhitespace(
  plainify(
    metaDescription
      ? metaDescription
      : pageDescription
        ? pageDescription
        : config.site.description,
  ),
);
if (!disableTagline) {
  title =
    title +
    (config.site.tagline &&
      (config.site.taglineSeparator || " - ") + config.site.tagline);
}
const baseUrl = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL(Astro.url.pathname, baseUrl);
const imageSrc = typeof image === "string" ? image : image.src;
const absoluteImageUrl = imageSrc ? new URL(imageSrc, baseUrl).href : undefined;
---

{absoluteImageUrl && <meta property="og:image" content={absoluteImageUrl} />}
{title && <meta property="og:title" content={removeWhitespace(title)} />}
{
  config.site.title && (
    <meta
      property="og:site_name"
      content={removeWhitespace(config.site.title)}
    />
  )
}
{description && <meta property="og:description" content={description} />}
{ogType && <meta property="og:type" content={ogType} />}
{ogLocale && <meta property="og:locale" content={ogLocale} />}
<meta property="og:url" content={pageUrl.href} />
{twitter && <meta name="twitter:creator" content={removeWhitespace(twitter)} />}
{title && <meta name="twitter:title" content={removeWhitespace(title)} />}
{description && <meta name="twitter:description" content={description} />}
{twitterCard && <meta name="twitter:card" content={twitterCard} />}
{absoluteImageUrl && <meta name="twitter:image" content={absoluteImageUrl} />}
