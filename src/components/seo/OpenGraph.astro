---
import type { ResolvedSeoMetadata } from "@/types/seo";

interface Props {
  metadata: ResolvedSeoMetadata;
}

const { metadata } = Astro.props;
---

{metadata.image && <meta property="og:image" content={metadata.image} />}
{metadata.title && <meta property="og:title" content={metadata.title} />}
{metadata.site.name && (
  <meta property="og:site_name" content={metadata.site.name} />
)}
{metadata.description && (
  <meta property="og:description" content={metadata.description} />
)}
{metadata.ogType && <meta property="og:type" content={metadata.ogType} />}
{metadata.ogLocale && <meta property="og:locale" content={metadata.ogLocale} />}
<meta property="og:url" content={metadata.canonical} />
{metadata.twitter && <meta name="twitter:creator" content={metadata.twitter} />}
{metadata.title && <meta name="twitter:title" content={metadata.title} />}
{metadata.description && (
  <meta name="twitter:description" content={metadata.description} />
)}
{metadata.twitterCard && (
  <meta name="twitter:card" content={metadata.twitterCard} />
)}
{metadata.image && <meta name="twitter:image" content={metadata.image} />}
