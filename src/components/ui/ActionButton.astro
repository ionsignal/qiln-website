---
import { formatUrl } from "@/utils/core";
import { markdownify } from "@/utils/text";
import type { HTMLAttributes } from "astro/types";

interface ActionContent {
  enable?: boolean;
  label: string;
  url?: string;
  rel?: string;
  target?: string;
}

interface BaseProps {
  content: ActionContent;
  class?: string;
}

type AnchorAttributes = Omit<
  HTMLAttributes<"a">,
  "class" | "href" | "rel" | "target"
>;

type ButtonAttributes = Omit<HTMLAttributes<"button">, "class">;

type AnchorProps = BaseProps &
  AnchorAttributes & {
    tag?: "a";
  };

type ButtonProps = BaseProps &
  ButtonAttributes & {
    tag: "button";
  };

type Props = AnchorProps | ButtonProps;

function isButtonProps(props: Props): props is ButtonProps {
  return props.tag === "button";
}

function getAnchorAttributes(props: AnchorProps): AnchorAttributes {
  const {
    tag: _tag,
    content: _content,
    class: _className,
    ...attributes
  } = props;

  return attributes;
}

function getButtonAttributes(props: ButtonProps): ButtonAttributes {
  const {
    tag: _tag,
    content: _content,
    class: _className,
    ...attributes
  } = props;

  return attributes;
}

const props = Astro.props;
const { enable, label, url, rel, target } = props.content;
const className = props.class;
const isButton = isButtonProps(props);
const buttonAttributes = isButton ? getButtonAttributes(props) : {};
const anchorAttributes = isButton ? {} : getAnchorAttributes(props);
const isExternal = url?.startsWith("http") ?? false;
const resolvedRel = isExternal ? rel || "noopener noreferrer" : rel;
const resolvedTarget = isExternal ? target || "_blank" : target;
---

{
  enable &&
    (isButton ? (
      <button
        data-content={label}
        class:list={["btn", className, "relative overflow-hidden"]}
        {...buttonAttributes}>
        <span class="label" set:html={markdownify(label)} />
        <slot />
      </button>
    ) : (
      <a
        rel={resolvedRel}
        target={resolvedTarget}
        href={url ? formatUrl(url) : undefined}
        data-content={label}
        class:list={["btn", className, "relative overflow-hidden"]}
        {...anchorAttributes}>
        <span class="label" set:html={markdownify(label)} />
        <slot />
      </a>
    ))
}
