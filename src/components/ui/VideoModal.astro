---
import LucideIcon from "@/components/helpers/LucideIcon.astro";
import type { VideoConfig } from "@/types";

interface Props {
  video: VideoConfig;
}

const { video } = Astro.props;
const {
  src,
  provider: configuredProvider = "youtube",
  poster,
  autoplay = true,
  type,
} = video;
const modalId = video.id?.trim() || "qiln-video-modal";
const provider = configuredProvider.trim().toLowerCase() || "youtube";
const isHtml5Video = provider === "html5";
const playerConfig = {
  hideControls: false,
  debug: false,
  iconUrl: "/plyr/plyr.svg",
  blankVideo: "/plyr/blank.mp4",
  youtube: {
    noCookie: true,
  },
};
---

{
  src && (
    <div
      id={modalId}
      class="hs-overlay pointer-events-none fixed inset-s-0 top-0 z-60 hidden size-full overflow-x-hidden overflow-y-auto"
      role="dialog"
      aria-modal="true"
      aria-label="Video player"
      tabindex="-1">
      <div class="hs-overlay-animation-target hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 flex min-h-[calc(100%-3.5rem)] items-center opacity-0 transition-[margin,opacity] ease-out sm:mx-auto sm:w-full sm:max-w-4xl">
        <div class="has-video-player pointer-events-auto container flex flex-col">
          <button
            type="button"
            aria-label="Close video"
            data-hs-overlay={`#${modalId}`}
            data-hs-overlay-options='{"emulateScrollbarSpace" : true}'
            class="mb-2 ml-auto flex h-10 w-10 items-center justify-center rounded-full bg-white ring-0 ring-white/50 duration-300 hover:rotate-90 hover:ring-4">
            <LucideIcon
              icon="X"
              class="text-dark/80 h-6 w-6"
              aria-hidden="true"
            />
          </button>
          {isHtml5Video ? (
            <video
              class="video-player"
              playsinline
              controls
              data-id={modalId}
              data-autoplay={autoplay ? "true" : "false"}
              data-poster={poster}
              data-plyr-config={JSON.stringify(playerConfig)}>
              <source src={src} type={type} />
            </video>
          ) : (
            <div
              class="video-player"
              data-autoplay={autoplay ? "true" : "false"}
              data-id={modalId}
              data-plyr-provider={provider}
              data-plyr-embed-id={src}
              data-plyr-poster={poster}
              data-plyr-config={JSON.stringify(playerConfig)}
            />
          )}
        </div>
      </div>
    </div>
  )
}

<script>
  type PlyrConstructor = (typeof import("plyr"))["default"];
  type PlyrInstance = InstanceType<PlyrConstructor>;

  interface PlayerRecord {
    player: PlyrInstance;
    autoplay: boolean;
    ready: boolean;
  }

  const players = new Map<HTMLElement, PlayerRecord>();
  const pendingPlayers = new Map<
    HTMLElement,
    Promise<PlayerRecord | undefined>
  >();

  let autoplayRequests = new WeakSet<HTMLElement>();
  let playerConstructorPromise: Promise<PlyrConstructor> | null = null;
  let listenerController: AbortController | null = null;
  let lifecycleId = 0;

  function loadPlayerConstructor(): Promise<PlyrConstructor> {
    playerConstructorPromise ??= Promise.all([
      import("plyr"),
      import("plyr/dist/plyr.css"),
    ]).then(([module]) => module.default);

    return playerConstructorPromise;
  }

  function requestPlayback(overlay: HTMLElement, record: PlayerRecord): void {
    if (!record.autoplay) return;

    autoplayRequests.add(overlay);

    if (record.ready) {
      void record.player.play();
    }
  }

  function pausePlayer(overlay: HTMLElement): void {
    autoplayRequests.delete(overlay);

    const record = players.get(overlay);
    if (!record || record.player.pip) return;

    record.player.pause();
  }

  async function createPlayer(
    overlay: HTMLElement,
    expectedLifecycleId: number,
  ): Promise<PlayerRecord | undefined> {
    const playerElement = overlay.querySelector<HTMLElement>(".video-player");

    if (!playerElement) return undefined;

    const Plyr = await loadPlayerConstructor();

    if (
      expectedLifecycleId !== lifecycleId ||
      !overlay.isConnected ||
      !playerElement.isConnected
    ) {
      return undefined;
    }

    const player = new Plyr(playerElement);
    const record: PlayerRecord = {
      player,
      autoplay: playerElement.dataset.autoplay === "true",
      ready: player.autoplay,
    };

    players.set(overlay, record);

    player.on("ready", () => {
      record.ready = true;

      if (autoplayRequests.has(overlay)) {
        requestPlayback(overlay, record);
      }
    });

    if (autoplayRequests.has(overlay)) {
      requestPlayback(overlay, record);
    }

    return record;
  }

  function ensurePlayer(
    overlay: HTMLElement,
  ): Promise<PlayerRecord | undefined> {
    const existingPlayer = players.get(overlay);
    if (existingPlayer) {
      return Promise.resolve(existingPlayer);
    }

    const pendingPlayer = pendingPlayers.get(overlay);
    if (pendingPlayer) {
      return pendingPlayer;
    }

    const expectedLifecycleId = lifecycleId;
    const playerPromise = createPlayer(overlay, expectedLifecycleId);

    pendingPlayers.set(overlay, playerPromise);

    playerPromise.then(
      () => {
        if (pendingPlayers.get(overlay) === playerPromise) {
          pendingPlayers.delete(overlay);
        }
      },
      () => {
        if (pendingPlayers.get(overlay) === playerPromise) {
          pendingPlayers.delete(overlay);
        }
      },
    );

    return playerPromise;
  }

  function initializePlayerForOverlay(
    overlay: HTMLElement,
    requestAutoplay: boolean,
  ): void {
    if (requestAutoplay) {
      autoplayRequests.add(overlay);
    }

    void ensurePlayer(overlay)
      .then((record) => {
        if (record && requestAutoplay && autoplayRequests.has(overlay)) {
          requestPlayback(overlay, record);
        }
      })
      .catch((error: unknown) => {
        autoplayRequests.delete(overlay);
        console.error("[VideoModal] Failed to load Plyr.", error);
      });
  }

  function initializeVideoModals() {
    listenerController?.abort();

    const controller = new AbortController();
    const configuredOverlays = new Set<HTMLElement>();

    listenerController = controller;

    document
      .querySelectorAll<HTMLElement>("[data-hs-overlay].video-modal-toggle")
      .forEach((button) => {
        const modalId = button.getAttribute("aria-controls");
        const overlay = modalId ? document.getElementById(modalId) : null;

        if (!overlay) return;

        button.addEventListener(
          "click",
          () => {
            initializePlayerForOverlay(overlay, true);
          },
          { signal: controller.signal },
        );

        if (configuredOverlays.has(overlay)) return;
        configuredOverlays.add(overlay);

        overlay.addEventListener(
          "open.hs.overlay",
          () => {
            initializePlayerForOverlay(overlay, true);
          },
          { signal: controller.signal },
        );

        overlay.addEventListener(
          "close.hs.overlay",
          () => {
            pausePlayer(overlay);
          },
          { signal: controller.signal },
        );
      });
  }

  function teardownVideoModals() {
    lifecycleId++;
    listenerController?.abort();
    listenerController = null;
    autoplayRequests = new WeakSet<HTMLElement>();
    pendingPlayers.clear();

    players.forEach(({ player }) => {
      player.destroy();
    });
    players.clear();
  }

  initializeVideoModals();

  window.addEventListener("pagehide", teardownVideoModals);
  window.addEventListener("pageshow", initializeVideoModals);
</script>
