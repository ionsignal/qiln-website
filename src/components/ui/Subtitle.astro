---
import LucideIcon from "@/components/helpers/LucideIcon.astro";
import { markdownify } from "@/utils/text";
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"div">, "class"> & {
  content?: string;
  class?: string;
};

const { content, class: className, ...attributes } = Astro.props;
---

{
  content && (
    <div
      class:list={[
        "from-primary/20 to-primary/5 mx-auto mb-2.5 flex w-fit items-center gap-2 rounded-full bg-linear-to-r from-80% py-1 ps-5 pe-2.5 text-white capitalize",
        className,
      ]}
      {...attributes}>
      <span set:html={markdownify(content)} />
      <LucideIcon icon="Sparkles" width="20" height="20" aria-hidden="true" />
    </div>
  )
}
