---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { fetchEntry, fetchRequiredEntry } from "@/utils/content";
import Hero from "@/components/sections/hero/Hero.astro";
import FeatureSplit from "@/components/sections/FeatureSplit.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import KnownGoodDiagram from "@/components/deck/slides/diagrams/KnownGoodDiagram.astro";
import TitleDiagram from "@/components/deck/slides/diagrams/TitleDiagram.astro";
import DiffsTestsDiagram from "@/components/deck/slides/diagrams/DiffsTestsDiagram.astro";
import RollbackDiagram from "@/components/deck/slides/diagrams/RollbackDiagram.astro";
// import BlueprintSection from "@/components/sections/BlueprintSection.astro";
// import CallToAction from "@/components/sections/CallToAction.astro";
// import ComparisonSection from "@/components/sections/ComparisonSection.astro";

const homepage = await fetchRequiredEntry("homepage", "-index");
const knownGoodSnapshots = await fetchEntry("sections", "known-good-snapshots");
const forkedBranches = await fetchEntry("sections", "forked-branches");
const capsuleDiffsAndGoldenTests = await fetchEntry(
  "sections",
  "golden-tests-and-diffs",
);
const promotionAndRollback = await fetchEntry(
  "sections",
  "promotion-and-rollback",
);
// const blueprint = await fetchEntry("sections", "blueprint");
// const comparison = await fetchEntry("sections", "comparison");
---

<SiteLayout {...homepage.data}>
  <Hero />
  {knownGoodSnapshots && (
    <FeatureSplit
      id="known-good-snapshots"
      content={knownGoodSnapshots.data}
      diagram={KnownGoodDiagram}
      imagePosition="right"
    />
  )}
  {forkedBranches && (
    <FeatureSplit
      id="forked-branches"
      content={forkedBranches.data}
      diagram={TitleDiagram}
      imagePosition="left"
      hasBackground={true}
    />
  )}
  {capsuleDiffsAndGoldenTests && (
    <FeatureSplit
      id="golden-tests-and-diffs"
      content={capsuleDiffsAndGoldenTests.data}
      diagram={DiffsTestsDiagram}
      imagePosition="right"
    />
  )}
  {promotionAndRollback && (
    <FeatureSplit
      id="promotion-and-rollback"
      content={promotionAndRollback.data}
      diagram={RollbackDiagram}
      imagePosition="left"
      hasBackground={true}
    />
  )}
  <!-- {blueprint && <BlueprintSection content={blueprint.data} />} -->
  <!-- {comparison && <ComparisonSection content={comparison.data} />} -->
  <FaqSection />
  <!-- <CallToAction /> -->
</SiteLayout>
