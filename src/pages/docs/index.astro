---
import { getEntry, render } from "astro:content";
import FileTree from "@/components/shortcodes/FileTree.astro";
import Callout from "@/components/shortcodes/Callout.astro";
import DocsLayout from "@/layouts/DocsLayout.astro";

const entry = await getEntry("docs", "index");
if (!entry) {
  return Astro.redirect("/404");
}

const { Content, headings } = await render(entry);
---

<DocsLayout entry={entry} headings={headings}>
  <Content components={{ FileTree, Callout }} />
</DocsLayout>
