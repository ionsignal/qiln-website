---
import { render } from "astro:content";
import { getAllDocs } from "@/utils/docs";
import DocsLayout from "@/layouts/DocsLayout.astro";
import FileTree from "@/components/shortcodes/FileTree.astro";
import Callout from "@/components/shortcodes/Callout.astro";
import type { DocEntry } from "@/types/docs";

export async function getStaticPaths() {
  const docs = await getAllDocs();
  const children = docs.filter((entry) => entry.id !== "index");
  return children.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: DocEntry;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout entry={entry} headings={headings}>
  <Content components={{ FileTree, Callout }} />
</DocsLayout>
