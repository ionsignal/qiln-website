---
import Base from "@/layouts/Base.astro";
import { fetchEntry } from "@/utils/content";
import PricingSection from "@/components/sections/PricingSection.astro";
import { markdownify } from "@/utils/text";

const pricingData = await fetchEntry("sections", "pricing");

if (!pricingData) {
  throw new Error("Pricing data (src/content/sections/pricing.mdx) not found.");
}
---

<Base {...pricingData.data}>
  <section class="relative pt-24 pb-12 lg:pt-32 lg:pb-16">
    <div class="container">
      <div class="mx-auto max-w-3xl text-center">
        <h1
          class="text-h2 md:text-h1 font-secondary mb-6 font-bold text-white"
          set:html={markdownify(pricingData.data.title || "Pricing")}
        />
        <p
          class="text-text-default text-lg leading-relaxed md:text-xl"
          set:html={markdownify(pricingData.data.description || "")}
        />
      </div>
    </div>
  </section>
  <PricingSection content={pricingData.data} />
</Base>
